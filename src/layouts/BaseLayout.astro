---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  offsetHeader?: boolean;
}

const {
  title = 'બુરહાની એન્ટરપ્રાઈઝ — ગેસ સોલ્યુશન્સ, ડિજિટલ વજન કાંટા અને સોફ્ટવેર',
  description = 'બુરહાની એન્ટરપ્રાઈઝ: ડિજિટલ વજન કાંટા, કેલિબ્રેશન અને લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ સહાય, વેઇબ્રિજ, કોમર્શિયલ LPG પાઇપલાઇન, દરેક પ્રકારના ગેસ સ્ટવ, તમામ સ્પેરપાર્ટ્સ, રિપેરિંગ અને સ્થાનિક વેપાર સોફ્ટવેર. ઉમરેઠ, ગુજરાત.',
  canonical = Astro.url.href,
  ogImage = '/images/og-card.jpg',
  keywords = 'બુરહાની એન્ટરપ્રાઈઝ, Burhani Enterprise, Burhani Gas, digital weighing scale Umreth, weighing machine Anand, platform scales Gujarat, Rolex weighing scale Umreth, gas stove repair Umreth, LPG pipeline fitting, commercial kitchen manifold, Legal Metrology stamping, weighing machine calibration, Saifteq Technologies, software development Umreth, વજન કાંટા ઉમરેઠ, ગેસ ચૂલા રિપેરિંગ, ઓરિજિનલ સ્પેરપાર્ટ્સ',
  offsetHeader = true,
} = Astro.props as Props;

const siteUrl = 'https://burhanienterprise.me';
const fullCanonical = canonical.startsWith('http') ? canonical : `${siteUrl}${canonical}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const siteTitle = title.includes('બુરહાની એન્ટરપ્રાઈઝ') || title.includes('Burhani Enterprise') ? title : `${title} | બુરહાની એન્ટરપ્રાઈઝ`;
const currentPath = Astro.url.pathname;

// Global Website Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Burhani Enterprise',
  alternateName: 'બુરહાની એન્ટરપ્રાઈઝ',
  description:
    'Authorized retail showroom for digital weighing scales, Legal Metrology stamping, gas stoves, commercial LPG pipelines, and software solutions in Umreth, Gujarat.',
  inLanguage: ['gu-IN', 'en-IN'],
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/weighing-scales?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Global Organization Schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Burhani Enterprise',
  alternateName: ['બુરહાની એન્ટરપ્રાઈઝ', 'Burhani Gas', 'Burhani Enterprise Umreth'],
  url: siteUrl,
  logo: `${siteUrl}/images/banner/banner-1.jpg`,
  image: `${siteUrl}/images/og-card.jpg`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '01 Vhorvad Lokhand Bazar, infront of Old Post office, Nr. kansara bazar',
    addressLocality: 'Umreth',
    addressRegion: 'Gujarat',
    postalCode: '388220',
    addressCountry: 'IN',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+91-99984-50711',
      contactType: 'sales and gas solutions',
      areaServed: 'IN',
      availableLanguage: ['Gujarati', 'Hindi', 'English'],
    },
    {
      '@type': 'ContactPoint',
      telephone: '+91-99741-64452',
      contactType: 'weighing systems and calibration',
      areaServed: 'IN',
      availableLanguage: ['Gujarati', 'Hindi', 'English'],
    },
    {
      '@type': 'ContactPoint',
      telephone: '+91-95747-13452',
      contactType: 'software development consultant',
      areaServed: 'IN',
      availableLanguage: ['Gujarati', 'Hindi', 'English'],
    },
  ],
  sameAs: [
    'https://maps.app.goo.gl/RFh4gTAqxjBGrsXm8',
    'https://maps.app.goo.gl/vPwkw5BwUv8DXLoY9',
    'https://saifteq.com',
  ],
};
---

<!doctype html>
<html lang="gu" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#030712" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Burhani Enterprise" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={fullCanonical} />

    <!-- Language Alternates / Hreflang for SEO -->
    <link rel="alternate" hreflang="gu" href={fullCanonical} />
    <link rel="alternate" hreflang="en" href={fullCanonical} />
    <link rel="alternate" hreflang="x-default" href={fullCanonical} />

    <!-- Local SEO Geo Meta Tags -->
    <meta name="geo.region" content="IN-GJ" />
    <meta name="geo.placename" content="Umreth, Anand District, Gujarat, India" />
    <meta name="geo.position" content="22.699323;73.117463" />
    <meta name="ICBM" content="22.699323, 73.117463" />

    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Gujarati:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Hero & Scale Image Preload -->
    <link rel="preload" as="image" href="/images/banner/banner-1.jpg" type="image/jpeg" />
    <link rel="preload" as="image" href="/images/scale/scale-8.webp" type="image/webp" />

    <!-- Favicon & PWA Web App Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Burhani Enterprise (બુરહાની એન્ટરપ્રાઈઝ)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Burhani Enterprise — Gas Solutions, Weighing Systems & Software, Umreth" />
    <meta property="og:locale" content="gu_IN" />
    <meta property="og:locale:alternate" content="en_IN" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Global Structured Data (Organization & WebSite Schemas) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>

  <body class="bg-background text-text selection:bg-primary selection:text-[#030712]">
    <!-- Accessibility: Skip to Main Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-[#030712] focus:font-semibold focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary-hover"
    >
      Skip to main content
    </a>

    <!-- Top-level Application Layout Wrapper -->
    <div id="app" class="relative flex min-h-screen flex-col overflow-hidden bg-background">
      <!-- Background Ambient Glow Overlay -->
      <div
        class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--color-surface-soft)_0%,_transparent_60%)] opacity-70"
        aria-hidden="true"
      ></div>

      <!-- Mount Navigation in Header Slot -->
      <slot name="header">
        <Navbar currentPath={currentPath} />
      </slot>

      <!-- Main Content Offset via --header-height Variable -->
      <main
        id="main-content"
        class:list={[
          'flex-1 focus:outline-none',
          offsetHeader && 'offset-header',
        ]}
      >
        <slot />
      </main>

      <slot name="footer" />
    </div>

    <!-- Interactive Client-Side Language Toggle Script (Default: Gujarati) -->
    <script is:inline>
      (function () {
        function getInitialLanguage() {
          const saved = localStorage.getItem('burhani_lang');
          if (saved === 'en' || saved === 'gu') return saved;
          return 'gu'; // Default language MUST be Gujarati
        }

        function setLanguage(lang) {
          if (lang !== 'en' && lang !== 'gu') lang = 'gu';
          try {
            localStorage.setItem('burhani_lang', lang);
          } catch (e) {}
          document.documentElement.lang = lang;

          // Update active state on all toggle buttons (.lang-btn-gu, .lang-btn-en)
          const guButtons = document.querySelectorAll('.lang-btn-gu');
          const enButtons = document.querySelectorAll('.lang-btn-en');

          if (lang === 'gu') {
            guButtons.forEach(function (b) {
              b.classList.add('bg-primary', 'text-[#030712]', 'font-semibold');
              b.classList.remove('text-text-muted');
              b.setAttribute('aria-pressed', 'true');
            });
            enButtons.forEach(function (b) {
              b.classList.remove('bg-primary', 'text-[#030712]', 'font-semibold');
              b.classList.add('text-text-muted');
              b.setAttribute('aria-pressed', 'false');
            });
          } else {
            enButtons.forEach(function (b) {
              b.classList.add('bg-primary', 'text-[#030712]', 'font-semibold');
              b.classList.remove('text-text-muted');
              b.setAttribute('aria-pressed', 'true');
            });
            guButtons.forEach(function (b) {
              b.classList.remove('bg-primary', 'text-[#030712]', 'font-semibold');
              b.classList.add('text-text-muted');
              b.setAttribute('aria-pressed', 'false');
            });
          }

          // Swap text for all elements with data-i18n-gu / data-i18n-en
          const translatableElements = document.querySelectorAll('[data-i18n-gu], [data-i18n-en]');
          translatableElements.forEach(function (el) {
            const text = el.getAttribute(lang === 'gu' ? 'data-i18n-gu' : 'data-i18n-en');
            if (text !== null) {
              if (el.getAttribute('data-i18n-mode') === 'html') {
                el.innerHTML = text;
              } else {
                el.textContent = text;
              }
            }
          });

          // Show/Hide language-specific containers
          document.querySelectorAll('[data-lang-show]').forEach(function (el) {
            const showFor = el.getAttribute('data-lang-show');
            if (showFor === lang) {
              el.style.display = '';
            } else {
              el.style.display = 'none';
            }
          });

          // Update document title if present
          if (lang === 'en') {
            document.title = 'Burhani Enterprise — Gas Solutions, Weighing Systems & Software';
          } else {
            document.title = 'બુરહાની એન્ટરપ્રાઈઝ — ગેસ સોલ્યુશન્સ, ડિજિટલ વજન કાંટા અને સોફ્ટવેર';
          }

          window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang: lang } }));
        }

        window.__setAppLanguage = setLanguage;
        window.__getAppLanguage = getInitialLanguage;

        function init() {
          const currentLang = getInitialLanguage();
          setLanguage(currentLang);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }

        document.addEventListener('astro:page-load', init);

        // Delegated click handler for language buttons
        document.addEventListener('click', function (e) {
          const btn = e.target.closest('.lang-btn');
          if (btn && btn.dataset.lang) {
            e.preventDefault();
            setLanguage(btn.dataset.lang);
          }
        });
      })();
    </script>
  </body>
</html>
