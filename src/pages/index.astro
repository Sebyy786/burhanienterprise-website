---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/hero/Hero.astro';
import ShopGallery from '../sections/shop/ShopGallery.astro';
import ScaleSection from '../sections/scale/ScaleSection.astro';
import GasSection from '../sections/gas/GasSection.astro';
import SoftwareSection from '../sections/software/SoftwareSection.astro';
import LocationSection from '../sections/location/LocationSection.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout
  title="બુરહાની એન્ટરપ્રાઈઝ — વજન કાંટા, ગેસ સાધનો અને સોફ્ટવેર | Burhani Enterprise"
  description="બુરહાની એન્ટરપ્રાઇઝ: નવા ડિજિટલ વજન કાંટા, ગેસ ચૂલા, ઓરિજિનલ સ્પેરપાર્ટ્સ, રિપેરિંગ સેવાઓ અને સોફ્ટવેર ડેવલપમેન્ટ. ઉમરેઠ અને આણંદ જિલ્લો."
>
  <!-- Section 1 — Hero Banner Carousel -->
  <Hero />

  <!-- Shop Gallery — "Visit Our Shop" (Temporary Placeholder — Replace with Real Shop Photo) -->
  <ShopGallery />

  <!-- Section 2 — Weighing Scales & Repair -->
  <ScaleSection />

  <!-- Section 3 — Gas Stoves, Equipment & Repair -->
  <GasSection />

  <!-- Section 4 — Software Development Services -->
  <SoftwareSection />

  <!-- Section 5 — Location & Google Reviews -->
  <LocationSection />

  <Footer slot="footer" />
</BaseLayout>