  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'ઉમરેઠમાં બુરહાની એન્ટરપ્રાઈઝ ક્યાં આવેલું છે? (Where is Burhani Enterprise located?)',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'બુરહાની એન્ટરપ્રાઇઝ ઉમરેઠમાં લોખંડ બજાર, જૂની પોસ્ટ ઓફિસ સામે, કંસારા બજાર પાસે, ઉમરેઠ, આણંદ જિલ્લો, ગુજરાત (પિન: ૩૮૮૨૨૦) ખાતે આવેલું છે. (01 Vhorvad Lokhand Bazar, infront of Old Post office, Nr. Kansara Bazar, Umreth, Gujarat 388220). ફોન: +91 99984 50711.',
      },
    },
