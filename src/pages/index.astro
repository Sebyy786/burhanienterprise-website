// Breadcrumb Schema for Homepage
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'મુખ્ય પૃષ્ઠ (Home)',
      item: 'https://burhanienterprise.me/',
    },
  ],
};
---

<BaseLayout
  title="બુરહાની એન્ટરપ્રાઈઝ — વજન કાંટા, ગેસ સાધનો અને સોફ્ટવેર | Burhani Enterprise"
  description="બુરહાની એન્ટરપ્રાઇઝ ઉમરેઠ: નવા ડિજિટલ વજન કાંટા, લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ, ગેસ ચૂલા રિપેરિંગ, ઓરિજિનલ સ્પેરપાર્ટ્સ, કોમર્શિયલ LPG પાઇપલાઇન અને સોફ્ટવેર ડેવલપમેન્ટ. ઉમરેઠ અને આણંદ જિલ્લો."
  canonical="https://burhanienterprise.me/"
>
  <!-- SEO Structured Data: LocalBusiness, FAQPage, BreadcrumbList -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Section 1 — Hero Banner Carousel -->
  <Hero />

  <!-- Shop Gallery — "Visit Our Shop" (Temporary Placeholder — Replace with Real Shop Photo) -->
  <ShopGallery />

  <!-- Section 2 — Weighing Scales & Repair -->
  <ScaleSection />

  <!-- Section 3 — Gas Stoves, Equipment & Repair -->
  <GasSection />

  <!-- Section 4 — Software Development Services -->
  <SoftwareSection />

  <!-- Section 5 — Location & Google Reviews -->
  <LocationSection />

  <Footer slot="footer" />
</BaseLayout>