---

<section
  id="software"
  class="relative py-20 sm:py-28 bg-[#020617] border-t border-border-subtle overflow-hidden"
  aria-label="Section 3 — Software Solutions and Automation"
>
  <!-- Ambient Indigo / Violet Glow Accent -->
  <div
    class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.08)_0%,transparent_70%)] blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-14 sm:gap-20">
    <!-- Section Header with Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 font-gujarati">
      <div>
        <div class="mb-3">
          <Badge variant="gold" size="sm">
            <span
              data-i18n-gu="વિભાગ ૦૩ • સોફ્ટવેર સોલ્યુશન્સ &amp; AI"
              data-i18n-en="Section 03 • Software Solutions &amp; AI"
            >
              વિભાગ ૦૩ • સોફ્ટવેર સોલ્યુશન્સ &amp; AI
            </span>
          </Badge>
        </div>

        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white tracking-tight leading-snug sm:leading-tight mb-2"
        >
          <span
            data-i18n-gu="આધુનિક સોફ્ટવેર સોલ્યુશન્સ અને "
            data-i18n-en="Modern Software Solutions &amp; "
          >આધુનિક સોફ્ટવેર સોલ્યુશન્સ અને </span>
          <span
            class="text-indigo-400 font-serif italic"
            data-i18n-gu="વેઇબ્રિજ ઓટોમેશન"
            data-i18n-en="Weighbridge Automation"
          >વેઇબ્રિજ ઓટોમેશન</span>
        </h2>

        <p
          class="text-xs sm:text-sm text-text-muted leading-relaxed font-body max-w-2xl"
          data-i18n-gu="વેઇબ્રિજ સ્લિપ પ્રિન્ટિંગ, ERP ઇન્ટિગ્રેશન, વાહન એન્ટ્રી/એક્ઝિટ, રિયલ-ટાઇમ એનાલિટિક્સ અને AI આધારિત કસ્ટમ બિઝનેસ સોફ્ટવેર."
          data-i18n-en="Weighbridge slip printing, ERP integration, vehicle entry/exit tracking, live analytics, and custom AI enterprise automation."
        >
          વેઇબ્રિજ સ્લિપ પ્રિન્ટિંગ, ERP ઇન્ટિગ્રેશન, વાહન એન્ટ્રી/એક્ઝિટ, રિયલ-ટાઇમ એનાલિટિક્સ અને AI આધારિત કસ્ટમ બિઝનેસ સોફ્ટવેર.
        </p>
      </div>

      <!-- Carousel Navigation Controls -->
      <div class="flex items-center gap-3 shrink-0 select-none">
        <span class="text-[11px] font-mono text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/30 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
          <span>૪-૫ સેકન્ડ સ્લાઇડર</span>
        </span>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="software-embla-prev"
            aria-label="અગાઉનું સોફ્ટવેર"
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-border bg-[#050b24] hover:border-indigo-400/80 hover:text-indigo-400 text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button
            type="button"
            id="software-embla-next"
            aria-label="આગળનું સોફ્ટવેર"
            class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-border bg-[#050b24] hover:border-indigo-400/80 hover:text-indigo-400 text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- 1. Embla Multi-Card Horizontal Carousel (3-4 desktop, 2 tablet, 1 mobile) -->
    <div class="w-full relative select-none">
      <div class="embla overflow-hidden cursor-grab active:cursor-grabbing" id="software-embla-viewport">
        <div class="embla__container flex -ml-4 sm:-ml-5">
          {
            softwareItems.map((item) => (
              <div class="embla__slide flex-[0_0_100%] sm:flex-[0_0_50%] lg:flex-[0_0_33.333%] xl:flex-[0_0_25%] pl-4 sm:pl-5 min-w-0 font-gujarati">
                <div class="h-full flex flex-col justify-between rounded-2xl bg-gradient-to-b from-[#070e2f] via-[#03081e] to-[#010414] border border-border/80 hover:border-indigo-500/60 shadow-xl hover:shadow-[0_12px_35px_rgba(99,102,241,0.15)] transition-all duration-300 group overflow-hidden p-4 sm:p-5">
                  <!-- Image Frame -->
                  <div>
                    <div class="relative w-full h-48 sm:h-52 bg-[#01030e] rounded-xl overflow-hidden flex items-center justify-center p-2.5 mb-4 border border-border-subtle group-hover:border-indigo-500/40 transition-colors">
                      <img
                        src={item.src}
                        alt={item.alt}
                        loading="lazy"
                        decoding="async"
                        class="max-w-full max-h-full object-contain rounded-lg transition-transform duration-300 group-hover:scale-105"
                      />
                      <div class="absolute top-2.5 left-2.5 z-10">
                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#010414]/90 text-indigo-300 border border-indigo-500/40 backdrop-blur-md">
                          {item.badgeGu}
                        </span>
                      </div>
                    </div>

                    <!-- Feature Title & Description -->
                    <h3
                      class="text-sm sm:text-base font-heading font-bold text-white mb-1.5 line-clamp-1 group-hover:text-indigo-300 transition-colors"
                      data-i18n-gu={item.featureTitleGu}
                      data-i18n-en={item.featureTitleEn}
                    >
                      {item.featureTitleGu}
                    </h3>
                    <p
                      class="text-xs text-text-muted leading-relaxed line-clamp-2 mb-4 font-body"
                      data-i18n-gu={item.descGu}
                      data-i18n-en={item.descEn}
                    >
                      {item.descGu}
                    </p>
                  </div>

                  <!-- Demo CTA Button on Card -->
                  <div class="pt-3 border-t border-border-subtle/80 flex items-center justify-between gap-2">
                    <span class="text-[11px] font-mono text-indigo-400 font-semibold">લાઇવ ડેમો</span>
                    <a
                      href={`https://wa.me/${businessProfile.divisionContacts.software.phoneDigits}?text=${encodeURIComponent(item.demoMsg)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 hover:bg-indigo-600 hover:text-white font-heading font-bold text-xs transition-all shrink-0 active:scale-95 shadow-sm"
                      aria-label={`Request Demo for ${item.featureTitleEn} on WhatsApp`}
                    >
                      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
