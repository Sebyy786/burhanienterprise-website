<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initSoftwareEmbla() {
    const emblaNode = document.getElementById('software-embla-viewport');
    if (!emblaNode) return;

    const prevBtn = document.getElementById('software-embla-prev');
    const nextBtn = document.getElementById('software-embla-next');

    const autoplay = Autoplay({
      delay: 5000,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
    });

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: 'start',
        slidesToScroll: 1,
        skipSnaps: false,
      },
      [autoplay]
    );

    prevBtn?.addEventListener('click', () => emblaApi.scrollPrev());
    nextBtn?.addEventListener('click', () => emblaApi.scrollNext());
  }

  initSoftwareEmbla();
  document.addEventListener('astro:page-load', initSoftwareEmbla);
</script>
