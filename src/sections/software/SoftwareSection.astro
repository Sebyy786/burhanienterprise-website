---

<section
  id="software"
  class="relative py-16 sm:py-24 bg-[#020617] border-t border-border-subtle overflow-hidden"
  aria-label="સોફ્ટવેર સોલ્યુશન્સ & AI ઓટોમેશન"
>
  <!-- Ambient Indigo / Violet Glow Accent -->
  <div
    class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.08)_0%,transparent_70%)] blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-12 sm:gap-16">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center font-gujarati">
      <div class="mb-3">
        <Badge variant="gold" size="md">
          <span
            data-i18n-gu="વિભાગ ૦૩ • આધુનિક સોફ્ટવેર &amp; AI ઓટોમેશન"
            data-i18n-en="Division 03 • Modern Software &amp; AI Automation"
          >
            વિભાગ ૦૩ • આધુનિક સોફ્ટવેર &amp; AI ઓટોમેશન
          </span>
        </Badge>
      </div>

      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white tracking-tight leading-snug sm:leading-tight mb-4"
      >
        <span
          data-i18n-gu="સોફ્ટવેર સોલ્યુશન્સ અને "
          data-i18n-en="Software Solutions &amp; "
        >
          સોફ્ટવેર સોલ્યુશન્સ અને
        </span>{' '}
        <span
          class="text-indigo-400 font-serif italic"
          data-i18n-gu="AI ઓટોમેશન"
          data-i18n-en="AI Automation"
        >
          AI ઓટોમેશન
        </span>
      </h2>

      <p
        class="text-sm sm:text-base text-text-muted leading-relaxed font-body"
        data-i18n-gu="સ્થાનિક વેપારીઓ અને ઉદ્યોગો માટે વિશ્વકક્ષાના આધુનિક વેબ સોફ્ટવેર, કસ્ટમ ERP, વેઇબ્રિજ વજન પ્રિન્ટિંગ એપ્લિકેશન્સ અને AI ઓટોમેશન."
        data-i18n-en="World-class custom cloud software, enterprise ERP, weighbridge ticket automation, and AI workflows tailored for local businesses and modern enterprises."
      >
        સ્થાનિક વેપારીઓ અને ઉદ્યોગો માટે વિશ્વકક્ષાના આધુનિક વેબ સોફ્ટવેર, કસ્ટમ ERP, વેઇબ્રિજ વજન પ્રિન્ટિંગ એપ્લિકેશન્સ અને AI ઓટોમેશન.
      </p>
    </div>

    <!-- Multi-Card Embla Carousel Stage -->
    <div class="relative w-full">
      <!-- Carousel Navigation Header & Controls -->
      <div class="flex items-center justify-between px-2 pb-4 font-gujarati border-b border-border-subtle/70 mb-6">
        <div class="flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-indigo-400 shadow-[0_0_8px_rgba(129,140,248,0.8)] animate-pulse"></span>
          <span
            class="text-xs sm:text-sm font-heading font-bold text-white tracking-wide"
            data-i18n-gu="સોફ્ટવેર &amp; AI ઇન્ટરફેસ કેરોસલ (૬ સિસ્ટમ્સ)"
            data-i18n-en="Software &amp; AI Interface Carousel (6 Systems)"
          >
            સોફ્ટવેર &amp; AI ઇન્ટરફેસ કેરોસલ (૬ સિસ્ટમ્સ)
          </span>
        </div>

        <!-- Carousel Action Buttons -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="software-embla-prev"
            aria-label="અગાઉનું સોફ્ટવેર"
            class="w-9 h-9 rounded-full border border-border bg-[#050b24] hover:border-indigo-400/80 hover:text-indigo-400 text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button
            type="button"
            id="software-embla-next"
            aria-label="આગળનું સોફ્ટવેર"
            class="w-9 h-9 rounded-full border border-border bg-[#050b24] hover:border-indigo-400/80 hover:text-indigo-400 text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Embla Carousel Viewport -->
      <div class="overflow-hidden cursor-grab active:cursor-grabbing select-none" id="software-embla-viewport">
        <div class="flex -ml-4 sm:-ml-5">
          {
            softwareItems.map((item) => (
              <div class="flex-[0_0_100%] sm:flex-[0_0_50%] lg:flex-[0_0_33.333%] xl:flex-[0_0_25%] pl-4 sm:pl-5 min-w-0 font-gujarati">
                <div class="h-full flex flex-col justify-between rounded-2xl bg-gradient-to-b from-[#070e2f] to-[#020514] border border-border/80 hover:border-indigo-500/60 transition-all duration-300 shadow-xl group overflow-hidden">
                  <!-- Image Frame -->
                  <div class="relative w-full h-56 sm:h-60 bg-[#01030e] p-2 flex items-center justify-center overflow-hidden border-b border-border-subtle/80">
                    <img
                      src={item.src}
                      alt={item.alt}
                      loading="lazy"
                      decoding="async"
                      class="max-w-full max-h-full object-contain rounded-lg transition-transform duration-500 group-hover:scale-105"
                    />
                    <div class="absolute top-2.5 left-2.5">
                      <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 backdrop-blur-md">
                        {item.badgeGu}
                      </span>
                    </div>
                    <div class="absolute bottom-2.5 right-2.5">
                      <span class="text-[10px] font-mono text-slate-300 bg-[#020512]/80 px-2 py-0.5 rounded border border-border-subtle backdrop-blur-sm">
                        {item.categoryGu}
                      </span>
                    </div>
                  </div>

                  <!-- Content Body -->
                  <div class="p-4 sm:p-5 flex flex-col flex-grow justify-between gap-4">
                    <div>
                      <h3
                        class="text-base font-heading font-bold text-white group-hover:text-indigo-300 transition-colors line-clamp-1 mb-1.5"
                        data-i18n-gu={item.nameGu}
                        data-i18n-en={item.nameEn}
                      >
                        {item.nameGu}
                      </h3>
                      <p
                        class="text-xs text-text-muted leading-relaxed line-clamp-2"
                        data-i18n-gu={item.descGu}
                        data-i18n-en={item.descEn}
                      >
                        {item.descGu}
                      </p>
                    </div>

                    <!-- Direct Contact CTA -->
                    <div class="pt-3 border-t border-border-subtle/60 flex items-center justify-between gap-2">
                      <div class="flex flex-col">
                        <span class="text-[9px] font-mono uppercase text-indigo-400 font-semibold" data-i18n-gu="સોફ્ટવેર વડા" data-i18n-en="Software Lead">સોફ્ટવેર વડા</span>
                        <span class="text-[11px] font-bold text-slate-300">{businessProfile.divisionContacts.software.name}</span>
                      </div>
                      <a
                        href={`https://wa.me/${businessProfile.divisionContacts.software.phoneDigits}?text=${encodeURIComponent(item.whatsappMsg)}`}
                        target="_blank"
                        rel="noopener noreferrer"
