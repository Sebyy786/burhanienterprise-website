    badge: 'Websites',
  },
  {
    id: 'sw-2',
    src: '/images/software/software-2.webp',
    alt: 'Mobile App Development - iOS and Android Applications',
    titleEn: 'Mobile App Development',
    titleGu: 'મોબાઇલ એપ ડેવલપમેન્ટ',
    descGu: 'વેપાર અને ફિલ્ડ ઓપરેશન્સ માટે એન્ડ્રોઇડ તથા આઇઓએસ મોબાઇલ એપ્સ.',
    badge: 'Mobile Apps',
  },
  {
    id: 'sw-3',
    src: '/images/software/software-3.webp',
    alt: 'AI Automation - Smart Business Workflows',
    titleEn: 'AI Automation',
    titleGu: 'AI ઓટોમેશન સોલ્યુશન્સ',
    descGu: 'સ્માર્ટ ચેટબોટ્સ, વોટ્સએપ ઓટોમેશન અને આર્ટિફિશિયલ ઇન્ટેલિજન્સ ટૂલ્સ.',
    badge: 'AI Automation',
  },
  {
    id: 'sw-4',
    src: '/images/software/software-4.webp',
    alt: 'GST Billing & Inventory Solutions - Stock Management',
    titleEn: 'GST Billing & Inventory',
    titleGu: 'જીએસટી બિલિંગ & સ્ટોક મેનેજમેન્ટ',
    descGu: 'સ્થાનિક દુકાન, વેપાર અને વજન સિસ્ટમ્સ સાથે સુસંગત GST બિલિંગ સોફ્ટવેર.',
    badge: 'GST & Stock',
  },
  {
    id: 'sw-5',
    src: '/images/software/software-5.webp',
    alt: 'Customer Management CRM - Leads and Client Pipeline',
    titleEn: 'Customer Management (CRM)',
    titleGu: 'ગ્રાહક સંચાલન (CRM)',
    descGu: 'ગ્રાહકો સાથે સંપર્ક, ફોલો-અપ અને ઓર્ડર ટ્રેકિંગ માટે સરળ CRM સોફ્ટવેર.',
    badge: 'CRM Solutions',
  },
  {
    id: 'sw-6',
    src: '/images/software/software-6.webp',
    alt: 'Reports & Analytics Dashboard - Real-time Business Metrics',
    titleEn: 'Reports & Analytics Dashboard',
    titleGu: 'એનાલિટિક્સ & રિપોર્ટ્સ ડેશબોર્ડ',
    descGu: 'દૈનિક વેચાણ, સ્ટોક રિપોર્ટિંગ અને રિયલ-ટાઇમ બિઝનેસ મેટ્રિક્સ ડેશબોર્ડ.',
    badge: 'Dashboards',
  },
  {
    id: 'sw-7',
    src: '/images/software/software-7.webp',
    alt: 'Custom Software Development - Tailored Engineering Solutions',
    titleEn: 'Custom Software Development',
    titleGu: 'કસ્ટમ સોફ્ટવેર ડેવલપમેન્ટ',
