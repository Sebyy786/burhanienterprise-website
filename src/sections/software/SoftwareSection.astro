const focusAreas = [
  {
    titleEn: 'Website Development',
    titleGu: 'વેબસાઇટ ડેવલપમેન્ટ',
    descGu: 'આધુનિક, રિસ્પોન્સિવ અને હાઇ-પરફોર્મન્સ પોર્ટફોલિયો તથા બિઝનેસ વેબસાઇટ્સ.',
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  },
  {
    titleEn: 'Mobile App Development',
    titleGu: 'મોબાઇલ એપ ડેવલપમેન્ટ',
    descGu: 'સરળ ઇન્ટરફેસ સાથે એન્ડ્રોઇડ અને આઇઓએસ બિઝનેસ એપ્લિકેશન્સ.',
    icon: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    titleEn: 'AI Automation',
    titleGu: 'AI ઓટોમેશન',
    descGu: 'ગ્રાહક સપોર્ટ માટે સ્માર્ટ AI ચેટબોટ્સ અને બિઝનેસ પ્રોસેસ ઓટોમેશન.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    titleEn: 'Custom Business Software',
    titleGu: 'કસ્ટમ બિઝનેસ સોફ્ટવેર',
    descGu: 'તમારા વેપાર, ઇન્વેન્ટરી અને બિલિંગ જરૂરિયાતો મુજબ તૈયાર કરેલું સોફ્ટવેર.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];

const consultationWhatsAppUrl = `https://wa.me/${softwareLead.phoneDigits}?text=${encodeURIComponent('Hello Shabbir, I would like to request a Software Consultation for Website, Mobile App, AI, or Custom Software.')}`;
---

<section
  id="software"
  class="relative py-16 sm:py-24 bg-[#020617] border-t border-border-subtle overflow-hidden"
  aria-label="Section — Software Development Services"
>
  <!-- Ambient Indigo / Violet Glow Accent -->
  <div
    class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-[radial-gradient(ellipse_at_center,rgba(99,102,241,0.08)_0%,transparent_70%)] blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-10 sm:gap-14">
    <!-- Header with Bilingual Titles, Short Description, and Carousel Navigation -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 font-gujarati">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white tracking-tight mb-1">
          Software Development Services
        </h2>

        <p class="text-lg sm:text-xl font-heading font-bold text-indigo-400 mb-2">
          સોફ્ટવેર ડેવલપમેન્ટ સર્વિસિસ
        </p>

        <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-body">
          સ્થાનિક વેપારીઓ અને આધુનિક વ્યવસાયો માટે વેબસાઇટ, મોબાઇલ એપ્લિકેશન, AI ઓટોમેશન અને કસ્ટમ સોફ્ટવેર ડેવલપમેન્ટ સોલ્યુશન્સ.
        </p>
      </div>

      <!-- Carousel Navigation Controls -->
      <div class="flex items-center gap-2 shrink-0 select-none">
        <button
          type="button"
          id="software-embla-prev"
          aria-label="Previous Software Slide"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-border bg-[#050b24] hover:border-indigo-400 hover:text-indigo-400 text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="software-embla-next"
          aria-label="Next Software Slide"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-border bg-[#050b24] hover:border-indigo-400 hover:text-indigo-400 text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Multi-Card Carousel (Realistic Software & Workstation Photos: 4 desktop / 2 tablet / 1 mobile) -->
    <div class="w-full relative select-none">
      <div class="embla overflow-hidden cursor-grab active:cursor-grabbing" id="software-embla-viewport">
        <div class="embla__container flex -ml-4 sm:-ml-5">
          {
            softwareSlides.map((item, index) => (
              <div class="embla__slide flex-[0_0_100%] sm:flex-[0_0_50%] lg:flex-[0_0_25%] pl-4 sm:pl-5 min-w-0 font-gujarati">
                <div class="h-full flex flex-col justify-between rounded-2xl bg-gradient-to-b from-[#070e2f] via-[#03081e] to-[#010414] border border-indigo-500/25 hover:border-indigo-500/60 shadow-xl hover:shadow-[0_12px_35px_rgba(99,102,241,0.15)] transition-all duration-300 group overflow-hidden p-4 sm:p-5">
                  <!-- Image Frame -->
                  <div>
                    <div class="relative w-full aspect-[4/3] bg-[#01030e] rounded-xl overflow-hidden flex items-center justify-center mb-3.5 border border-border-subtle group-hover:border-indigo-500/40 transition-colors">
                      <img
                        src={item.src}
                        alt={item.alt}
                        loading={index < 4 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                      <div class="absolute top-2 left-2 z-10">
                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#010414]/90 text-indigo-300 border border-indigo-500/40 backdrop-blur-md">
                          {item.badge}
                        </span>
                      </div>
                    </div>

                    <!-- Title & Short Description -->
                    <h3 class="text-sm font-heading font-bold text-white mb-1 line-clamp-1 group-hover:text-indigo-300 transition-colors">
                      {item.titleEn}
                    </h3>
                    <p class="text-[11px] font-mono text-indigo-400 truncate mb-2">
                      {item.titleGu}
                    </p>
                    <p class="text-xs text-text-muted leading-relaxed line-clamp-2 mb-3 font-body">
                      {item.descGu}
                    </p>
                  </div>

                  <!-- Card Footer: Tag -->
                  <div class="pt-3 border-t border-border-subtle/80 flex items-center justify-between text-[10px] font-mono text-slate-400">
                    <span class="text-indigo-300/80">Burhani Enterprise</span>
                    <span class="text-indigo-400 font-semibold">IT Solutions</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Software Visual Transparency Note -->
    <div class="max-w-2xl mx-auto text-center px-4 py-2.5 rounded-lg bg-[#040a24]/75 border border-indigo-500/20 font-gujarati text-[11px] sm:text-xs text-slate-400 select-none backdrop-blur-sm -mt-2">
      <span class="text-indigo-300 font-semibold inline-flex items-center gap-1" data-i18n-gu="વિઝ્યુઅલ નોંધ:" data-i18n-en="Visual Note:">
        <svg class="w-3.5 h-3.5 text-indigo-400 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        વિઝ્યુઅલ નોંધ:
      </span>
      <span
        data-i18n-gu=" ઉપરોક્ત સોફ્ટવેર વર્કસ્ટેશન તસવીરો અમારા વાસ્તવિક સોફ્ટવેર સોલ્યુશન્સ અને ડેવલપમેન્ટ સેવાઓને પ્રદર્શિત કરવા માટે પ્રતીકાત્મક (ઇલસ્ટ્રેટિવ / AI) છે."
        data-i18n-en=" Software workstation visuals above are illustrative placeholders created with AI to demonstrate real-world deployment workflows and technical engineering services."
      >
        ઉપરોક્ત સોફ્ટવેર વર્કસ્ટેશન તસવીરો અમારા વાસ્તવિક સોફ્ટવેર સોલ્યુશન્સ અને ડેવલપમેન્ટ સેવાઓને પ્રદર્શિત કરવા માટે પ્રતીકાત્મક (ઇલસ્ટ્રેટિવ / AI) છે.
      </span>
    </div>

    <!-- Core Focus Areas Grid: Website, Mobile App, AI Automation, Custom Business Software -->
    <div class="w-full flex flex-col gap-6 font-gujarati pt-2">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        {
          focusAreas.map((focus) => (
            <GlassCard padding="md" hoverEffect={true} class="flex flex-col justify-between border-indigo-500/20 bg-[#040a24] group">
              <div>
                <div class="w-9 h-9 rounded-lg bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform mb-3">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={focus.icon} />
                  </svg>
                </div>

                <h3 class="text-sm font-heading font-bold text-white mb-1 group-hover:text-indigo-300 transition-colors">
                  {focus.titleEn}
                </h3>
                <p class="text-xs text-indigo-400 font-medium mb-2">
                  {focus.titleGu}
                </p>
                <p class="text-xs text-text-muted leading-relaxed font-body">
                  {focus.descGu}
                </p>
              </div>

              <div class="pt-3 mt-3 border-t border-border-subtle/60 flex items-center justify-between text-[10px] font-mono text-slate-400">
                <span class="text-indigo-300">Modern Tech</span>
                <span class="text-emerald-400 font-semibold">Active</span>
              </div>
            </GlassCard>
          ))
        }
      </div>
    </div>

    <!-- Section Bottom Primary CTA: Request Software Consultation (Routed to Shabbir) -->
    <div class="flex items-center justify-center pt-2">
      <Button
        href={consultationWhatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="lg"
        ariaLabel="Request Software Consultation"
        class="shadow-xl shadow-indigo-500/20 bg-indigo-600 hover:bg-indigo-500 text-white font-bold border-none"
      >
        <svg slot="icon-left" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>Request Software Consultation</span>
      </Button>
    </div>
  </Container>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initSoftwareEmbla() {
    const emblaNode = document.getElementById('software-embla-viewport');
    if (!emblaNode) return;

    const prevBtn = document.getElementById('software-embla-prev');
    const nextBtn = document.getElementById('software-embla-next');

    const autoplay = Autoplay({
      delay: 4500,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
    });

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: 'start',
        slidesToScroll: 1,
        skipSnaps: false,
      },
      [autoplay]
    );

    prevBtn?.addEventListener('click', () => emblaApi.scrollPrev());
    nextBtn?.addEventListener('click', () => emblaApi.scrollNext());
  }

  initSoftwareEmbla();
  document.addEventListener('astro:page-load', initSoftwareEmbla);
</script>
