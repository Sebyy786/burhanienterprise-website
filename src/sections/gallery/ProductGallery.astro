---
import Container from '../../components/ui/Container.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { businessProfile } from '../../data/business';

interface ProductDivision {
  id: string;
  badge: string;
  title: string;
  tagline: string;
  description: string;
  primaryImage: string;
  primaryAlt: string;
  detailImage: string;
  detailAlt: string;
  detailCaption: string;
  features: string[];
  specs: Array<{ label: string; value: string }>;
  whatsappMsg: string;
  contactPerson: string;
  contactPhone: string;
  contactPhoneDigits: string;
}

const divisions: ProductDivision[] = [
  {
    id: 'gas-solutions',
    badge: 'Division 01 • Commercial LPG & Pipelines',
    title: 'Commercial LPG Cylinder Manifolds & Pipeline Systems',
    tagline: 'Engineered for commercial kitchens, hotels, bakeries, schools, and local factories.',
    description:
      'Custom-fabricated LPG cylinder manifold banks and gas pipeline distribution systems for restaurants, hotels, commercial kitchens, and manufacturing units. Built with dual-stage brass regulators, copper pigtails, safety ball valves, and certified pressure testing.',
    primaryImage: '/images/gas-solutions.jpg',
    primaryAlt: 'Commercial LPG Cylinder Manifold Installation by Burhani Enterprise',
    detailImage: '/images/gas-regulator-detail.jpg',
    detailAlt: 'Close-up of Dual-Stage Brass Gas Pressure Regulator on Yellow Pipeline',
    detailCaption: 'Dual-Gauge Brass Pressure Regulator Station',
    features: [
      'Dual-bank manifold headers with safety shut-off ball valves',
      'Flexible copper and braided stainless steel pigtails',
      'Dual-stage brass regulators with analog dial gauges',
      'Kitchen and factory gas pipeline layout with safety testing',
      'Direct on-site installation and prompt technical support',
    ],
    specs: [
      { label: 'Working Media', value: 'Commercial LPG & Industrial Gases' },
      { label: 'Header Setup', value: '2x2 up to 2x20 Cylinder Banks' },
      { label: 'Pressure Range', value: 'Dual-Stage High & Low Regulation' },
      { label: 'Service Scope', value: 'Piping, Regulators, Valves & AMC' },
    ],
    whatsappMsg:
      'Hello Burhanuddin, I would like to request an estimate for Commercial LPG Pipeline & Manifold installation.',
    contactPerson: businessProfile.divisionContacts.gas.name,
    contactPhone: businessProfile.divisionContacts.gas.phone,
    contactPhoneDigits: businessProfile.divisionContacts.gas.phoneDigits,
  },
  {
    id: 'weighing-solutions',
    badge: 'Division 02 • Commercial Weighing Systems',
    title: 'Truck Weighbridges, Platform Scales & Load Cells',
    tagline: 'Heavy-duty capacity with dependable repeatability for mills, warehouses, and factories.',
    description:
      'Modular structural steel truck weighbridge platforms in pit and pitless configurations (20T to 120T), platform bench scales, and digital load cells. Engineered with high-strength I-beam steel, hermetically sealed IP68 load cells, and digital indicator terminals with fast local service.',
    primaryImage: '/images/weighing-solutions.jpg',
    primaryAlt: 'Commercial Pitless Truck Weighbridge Platform Scale by Burhani Enterprise',
    detailImage: '/images/load-cell-detail.jpg',
    detailAlt: 'Heavy-Duty Digital Canister Compression Load Cell with Rocker Pin',
    detailCaption: 'IP68 Stainless Steel Canister Load Cell',
    features: [
      'Robust structural steel deck with heavy anti-skid chequered plate',
      'Hermetically sealed stainless steel compression load cells (IP68)',
      'Pit-mounted or Pitless surface-mounted configurations',
      'Intelligent digital weight indicators with RS232 / USB / printer support',
      'Rapid calibration, stamping assistance and on-site maintenance',
    ],
    specs: [
      { label: 'Capacity Range', value: '20 Tonnes up to 120 Tonnes' },
      { label: 'Standard Dimensions', value: '6m x 3m up to 18m x 3m (Custom spans)' },
      { label: 'Load Cell Type', value: 'Stainless Steel Compression / Rocker Pin' },
      { label: 'System Build', value: 'Heavy Commercial Industrial Standard' },
    ],
    whatsappMsg:
      'Hello Hozefa, I would like to request a quotation and layout for Truck Weighbridges.',
    contactPerson: businessProfile.divisionContacts.weighing.name,
    contactPhone: businessProfile.divisionContacts.weighing.phone,
    contactPhoneDigits: businessProfile.divisionContacts.weighing.phoneDigits,
  },
  {
    id: 'software-solutions',
    badge: 'Division 03 • Weighbridge & Business IT',
    title: 'Burhani Weighbridge Management Software & Automation',
    tagline: 'Automate weighment slips, prevent operator errors, and integrate with business ERP.',
    description:
      'Dedicated desktop weighbridge software and automation systems for commercial weighbridges and industrial dispatch yards. Features instant gross/tare/net calculation, custom ticket printing (dot-matrix and thermal), vehicle plate logging, optional CCTV snapshots, RFID driver cards, and Tally/ERP integration.',
    primaryImage: '/images/software-solutions.jpg',
    primaryAlt: 'Burhani Weighbridge Automation Desktop Software on PC Monitor',
    detailImage: '/images/unmanned-kiosk-detail.jpg',
    detailAlt: 'Outdoor Weatherproof Industrial Weighbridge Driver Kiosk and Terminal',
    detailCaption: 'Rugged Driver Self-Service Terminal',
    features: [
      'Instant gross, tare, and net calculation with ticket printout',
      'Custom slip printing for dot-matrix and thermal printers',
      'Vehicle license plate and customer party master records',
      'Driver self-service RFID card reader and optional CCTV capture',
      'Tally, Excel, and custom database data synchronization',
    ],
    specs: [
      { label: 'Software Suite', value: 'Burhani Weighbridge Desktop System' },
      { label: 'Compatibility', value: 'Windows 10 / 11 / Server OS' },
      { label: 'Indicator Sync', value: 'Supports all major digital indicator brands' },
      { label: 'Data Security', value: 'Tamper-Proof Weight Logs & Operator Roles' },
    ],
    whatsappMsg:
      'Hello Shabbir, I would like to schedule a demonstration of Burhani Weighbridge Management Software.',
    contactPerson: businessProfile.divisionContacts.software.name,
    contactPhone: businessProfile.divisionContacts.software.phone,
    contactPhoneDigits: businessProfile.divisionContacts.software.phoneDigits,
  },
];
---

<section
  id="products"
  class="relative py-20 sm:py-28 bg-[#02050e] border-t border-border-subtle overflow-hidden"
  aria-label="Burhani Enterprise Product Gallery"
>
  <!-- Background Decorative Grid Lines -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(212,175,55,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(212,175,55,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-70"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-14 sm:gap-20">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center font-gujarati">
      <div class="mb-4">
        <Badge variant="gold" size="sm">
          <span
            data-i18n-gu="પ્રોડક્ટ્સ અને સેવાઓ પોર્ટફોલિયો"
            data-i18n-en="Products &amp; Services Portfolio"
          >પ્રોડક્ટ્સ અને સેવાઓ પોર્ટફોલિયો</span>
        </Badge>
      </div>

      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white tracking-tight leading-snug sm:leading-tight mb-5"
      >
        <span
          data-i18n-gu="ત્રણ મુખ્ય વિભાગો. "
          data-i18n-en="Three Core Divisions. "
        >ત્રણ મુખ્ય વિભાગો. </span>{' '}
        <span
          class="gold-gradient-text font-serif italic"
          data-i18n-gu="ચોકસાઈ અને ગુણવત્તાનું એક નામ."
          data-i18n-en="One Name for Precision &amp; Quality."
        >ચોકસાઈ અને ગુણવત્તાનું એક નામ.</span>
      </h2>

      <p
        class="text-sm sm:text-base text-text-muted leading-relaxed font-body"
        data-i18n-gu="ઉત્તમ ગુણવત્તાવાળા ઔદ્યોગિક, વ્યાપારી અને સોફ્ટવેર સોલ્યુશન્સ."
        data-i18n-en="Superior quality industrial, commercial, and software solutions."
      >
        ઉત્તમ ગુણવત્તાવાળા ઔદ્યોગિક, વ્યાપારી અને સોફ્ટવેર સોલ્યુશન્સ.
      </p>

      <!-- Division Quick Navigation Pills -->
      <nav class="flex flex-wrap items-center justify-center gap-2.5 mt-8" aria-label="Division Quick Navigation">
        {
          divisions.map((division) => (
            <a
              href={`#${division.id}`}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-heading font-semibold bg-surface border border-border/70 text-text-muted hover:text-white hover:border-primary/60 hover:bg-surface-soft transition-all duration-200"
            >
              <span class="w-2 h-2 rounded-full bg-primary/70"></span>
              <span>{division.badge.split('•')[1]?.trim() || division.title}</span>
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Divisions Detailed Showcase Stack -->
    <div class="flex flex-col gap-20 sm:gap-28 max-w-6xl mx-auto w-full">
      {
        divisions.map((division, index) => {
          const isReversed = index % 2 !== 0;
          return (
            <article
              id={division.id}
              class="scroll-mt-28 flex flex-col gap-8 rounded-[var(--radius-2xl)] bg-[#070e24]/70 border border-border/60 p-6 sm:p-10 lg:p-12 shadow-2xl backdrop-blur-md relative overflow-hidden"
            >
              <!-- Top Gold Glint -->
              <div
                class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent"
                aria-hidden="true"
              />

              <!-- Division Header Strip -->
              <div class="flex flex-wrap items-center justify-between gap-4 border-b border-border-subtle pb-6">
                <span class="text-xs font-mono uppercase tracking-widest text-primary font-semibold bg-[#030712]/80 px-3 py-1 rounded-full border border-primary/30">
                  {division.badge}
                </span>

                <span class="text-xs font-mono text-text-subtle">
                  SYSTEM CODE: BE-DIV-0{index + 1}
                </span>
              </div>

              <!-- Main Content Grid: Images (Left/Right alternating) and Technical Specs -->
              <div
                class:list={[
                  'grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center',
                  isReversed && 'lg:direction-rtl',
                ]}
              >
                <!-- Photography Column (6 Cols) -->
                <div class="lg:col-span-6 flex flex-col gap-4">
                  <!-- Main Hero Product Photo -->
                  <div class="relative w-full h-64 sm:h-80 rounded-[var(--radius-xl)] bg-[#030712] border border-border overflow-hidden group shadow-soft">
                    <img
                      src={division.primaryImage}
                      alt={division.primaryAlt}
                      width="800"
                      height="500"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#030712] via-transparent to-transparent opacity-60" />
                    <div class="absolute bottom-3 left-3 bg-[#030712]/85 px-3 py-1 rounded border border-border-subtle text-[11px] font-mono text-text-gold backdrop-blur-xs">
                      Primary Installation
                    </div>
                  </div>

                  <!-- Secondary Detail Photo Strip -->
                  <div class="relative flex items-center gap-4 rounded-[var(--radius-lg)] bg-[#04091a] border border-border-subtle p-3">
                    <div class="w-24 h-20 shrink-0 rounded-[var(--radius-md)] overflow-hidden border border-border/40">
                      <img
                        src={division.detailImage}
                        alt={division.detailAlt}
                        width="200"
                        height="150"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover"
                      />
                    </div>
                    <div class="min-w-0 flex flex-col justify-center">
                      <span class="text-[10px] font-mono text-primary uppercase tracking-wider">
                        Component Detail
                      </span>
                      <p class="text-xs font-heading font-semibold text-white truncate mt-0.5">
                        {division.detailCaption}
                      </p>
                      <span class="text-[11px] text-text-muted mt-0.5 line-clamp-1">
                        High-precision industrial componentry
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Technical Details Column (6 Cols) -->
                <div class="lg:col-span-6 flex flex-col gap-6">
                  <div>
                    <h3 class="text-xl sm:text-2xl lg:text-3xl font-heading font-bold text-white mb-2 leading-tight">
                      {division.title}
                    </h3>
                    <p class="text-xs sm:text-sm font-medium text-text-gold font-heading mb-4">
                      {division.tagline}
                    </p>
                    <p class="text-sm text-text-muted leading-relaxed font-body">
                      {division.description}
                    </p>
                  </div>

                  <!-- Key Features Checklist -->
                  <div class="space-y-2.5">
                    <h4 class="text-xs font-mono uppercase tracking-wider text-text-subtle font-semibold">
                      Engineering Highlights
                    </h4>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-300 font-body">
                      {division.features.map((feature) => (
                        <li class="flex items-start gap-2">
                          <svg
                            class="h-4 w-4 text-primary shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.2"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Technical Specs Grid -->
                  <div class="rounded-[var(--radius-lg)] bg-[#030712]/70 border border-border-subtle p-4">
                    <h4 class="text-[11px] font-mono uppercase tracking-wider text-primary mb-3 font-semibold">
                      Technical Parameter Matrix
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-xs">
                      {division.specs.map((spec) => (
                        <div class="flex flex-col border-b border-border-subtle/50 pb-1.5 last:border-b-0 sm:last:border-b">
                          <span class="text-[10px] uppercase font-mono text-text-subtle">{spec.label}</span>
                          <span class="text-xs font-semibold text-white mt-0.5">{spec.value}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <!-- Action Buttons -->
                  <div class="flex flex-wrap items-center gap-3 pt-2">
                    <Button
                      href="#contact"
                      variant="primary"
                      size="sm"
                      class="px-5 py-2 text-xs font-semibold"
                    >
                      <span>Request Quote & Specs</span>
                      <svg
                        slot="icon-right"
                        class="h-3.5 w-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.2"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </Button>

                    <Button
                      href={`https://wa.me/${division.contactPhoneDigits}?text=${encodeURIComponent(division.whatsappMsg)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      variant="secondary"
                      size="sm"
                      class="px-4 py-2 text-xs border-border hover:border-primary/50"
                    >
                      <svg
                        slot="icon-left"
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3.5 w-3.5 fill-current text-[#25D366]"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                      </svg>
                      <span>WhatsApp {division.contactPerson.split(' ')[0]}</span>
                    </Button>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>
