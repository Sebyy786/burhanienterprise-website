---
import Container from '../../components/ui/Container.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { businessProfile } from '../../data/business';
---

<section
  id="contact"
  class="relative py-20 sm:py-28 bg-[#030712] border-t border-border-subtle overflow-hidden"
  aria-label="Request For Quote and Contact"
>
  <!-- Ambient Gold Light Chamber -->
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 w-[900px] h-[400px] bg-[radial-gradient(ellipse_at_bottom,rgba(212,175,55,0.08)_0%,transparent_70%)] blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-12 sm:gap-16">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
      <div class="mb-4">
        <Badge variant="gold" size="sm">
          <span>SERVING UMRETH & ANAND DISTRICT • DIRECT CONTACT</span>
        </Badge>
      </div>

      <h2
        class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white tracking-tight leading-snug sm:leading-tight mb-5"
      >
        Request a <span class="gold-gradient-text font-serif italic">Quote</span>
      </h2>

      <p class="text-sm sm:text-base text-text-muted leading-relaxed font-body max-w-2xl">
        Need a gas installation, weighbridge service, or custom software?
        <br class="hidden sm:inline" />
        Contact Burhani Enterprise for engineering consultation in Umreth and Anand district.
      </p>

      <!-- Primary & Secondary Quick Buttons -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <Button
          href={businessProfile.contact.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="md"
          class="px-6 py-2.5 text-xs font-semibold"
        >
          <svg
            slot="icon-left"
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 fill-current"
            viewBox="0 0 24 24"
          >
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
          <span>Request on WhatsApp</span>
        </Button>

        <Button
          href={`tel:${businessProfile.contact.phone.replace(/[^0-9+]/g, '')}`}
          variant="secondary"
          size="md"
          class="px-6 py-2.5 text-xs font-semibold border-border hover:border-primary/50"
        >
          <svg
            slot="icon-left"
            class="h-4 w-4 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Engineering Team</span>
        </Button>
      </div>
    </div>

    <!-- Dual Column Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 max-w-6xl mx-auto w-full items-start">
      <!-- Left Column: Direct Contact & Division Leads (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <GlassCard padding="lg" hoverEffect={false} class="border-border/60">
          <h3 class="text-lg sm:text-xl font-heading font-bold text-white mb-2">
            Burhani Enterprise
          </h3>
          <p class="text-xs text-text-muted mb-5 leading-relaxed">
            Local engineering provider serving Umreth & Anand District, Gujarat. Contact our division leads directly:
          </p>

          <!-- Direct Division Contacts -->
          <div class="space-y-3 text-xs sm:text-sm">
            <!-- Gas Solutions Contact -->
            <a
              href={businessProfile.divisionContacts.gas.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 p-3 rounded-[var(--radius-md)] bg-[#04091a] border border-border-subtle hover:border-primary/50 transition-colors group"
            >
              <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary group-hover:scale-105 transition-transform">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <span class="text-[10px] uppercase font-mono text-text-subtle block">Gas Solutions</span>
                <span class="font-heading font-semibold text-white group-hover:text-primary transition-colors block truncate">
                  {businessProfile.divisionContacts.gas.name}
                </span>
                <span class="text-xs text-text-gold font-mono">
                  {businessProfile.divisionContacts.gas.phone}
                </span>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/30 shrink-0">
                WhatsApp
              </span>
            </a>

            <!-- Weighing Solutions Contact -->
            <a
              href={businessProfile.divisionContacts.weighing.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 p-3 rounded-[var(--radius-md)] bg-[#04091a] border border-border-subtle hover:border-primary/50 transition-colors group"
            >
              <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary group-hover:scale-105 transition-transform">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <span class="text-[10px] uppercase font-mono text-text-subtle block">Weighing Solutions</span>
                <span class="font-heading font-semibold text-white group-hover:text-primary transition-colors block truncate">
                  {businessProfile.divisionContacts.weighing.name}
                </span>
                <span class="text-xs text-text-gold font-mono">
                  {businessProfile.divisionContacts.weighing.phone}
                </span>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/30 shrink-0">
                WhatsApp
              </span>
            </a>

            <!-- Software Solutions Contact -->
            <a
              href={businessProfile.divisionContacts.software.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3.5 p-3 rounded-[var(--radius-md)] bg-[#04091a] border border-border-subtle hover:border-primary/50 transition-colors group"
            >
              <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary group-hover:scale-105 transition-transform">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <span class="text-[10px] uppercase font-mono text-text-subtle block">Software Solutions</span>
                <span class="font-heading font-semibold text-white group-hover:text-primary transition-colors block truncate">
                  {businessProfile.divisionContacts.software.name}
                </span>
                <span class="text-xs text-text-gold font-mono">
                  {businessProfile.divisionContacts.software.phone}
                </span>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/30 shrink-0">
                WhatsApp
              </span>
            </a>

            <!-- Facility & Service Area -->
            <div class="flex items-start gap-3.5 p-3 rounded-[var(--radius-md)] bg-[#04091a] border border-border-subtle">
              <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0 text-primary mt-0.5">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-[10px] uppercase font-mono text-text-subtle block">Works & Operations</span>
                <span class="text-xs font-medium text-slate-300">
                  {businessProfile.contact.address}
                </span>
                <span class="text-[11px] text-text-subtle block mt-1">
                  Serving Umreth & Anand District, Gujarat
                </span>
              </div>
            </div>
          </div>
        </GlassCard>
      </div>

      <!-- Right Column: Interactive B2B RFQ Form (7 Cols) -->
      <div class="lg:col-span-7">
        <GlassCard padding="lg" hoverEffect={false} class="border-border/70 relative">
          <div class="flex items-center justify-between gap-2 border-b border-border-subtle pb-4 mb-6">
            <h3 class="text-base sm:text-lg font-heading font-semibold text-white">
              B2B Specification & Quotation Builder
            </h3>
            <span class="text-[10px] font-mono text-primary bg-[#030712] px-2.5 py-1 rounded border border-primary/20">
              CONFIDENTIAL
            </span>
          </div>

          <form id="rfq-form" class="space-y-4">
            <!-- Division Selection -->
            <div>
              <label class="block text-xs font-mono uppercase tracking-wider text-text-muted mb-2 font-semibold">
                Select Relevant Division(s)
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <label class="flex items-center gap-2 p-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle hover:border-primary/40 cursor-pointer text-xs text-slate-300">
                  <input type="checkbox" name="division" value="Gas Solutions" class="accent-[#d4af37] rounded" checked />
                  <span>Gas Solutions</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle hover:border-primary/40 cursor-pointer text-xs text-slate-300">
                  <input type="checkbox" name="division" value="Weighing Solutions" class="accent-[#d4af37] rounded" />
                  <span>Weighbridges</span>
                </label>
                <label class="flex items-center gap-2 p-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle hover:border-primary/40 cursor-pointer text-xs text-slate-300">
                  <input type="checkbox" name="division" value="Software Solutions" class="accent-[#d4af37] rounded" />
                  <span>Software</span>
                </label>
              </div>
            </div>

            <!-- Name and Company -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="rfq-name" class="block text-xs font-mono uppercase tracking-wider text-text-muted mb-1.5 font-semibold">
                  Contact Name *
                </label>
                <input
                  type="text"
                  id="rfq-name"
                  name="name"
                  required
                  placeholder="e.g. Rajesh Patel"
                  class="w-full px-3.5 py-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle text-white text-xs placeholder:text-text-subtle focus:border-primary focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="rfq-company" class="block text-xs font-mono uppercase tracking-wider text-text-muted mb-1.5 font-semibold">
                  Company / Organization *
                </label>
                <input
                  type="text"
                  id="rfq-company"
                  name="company"
                  required
                  placeholder="e.g. Apex Manufacturing Ltd."
                  class="w-full px-3.5 py-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle text-white text-xs placeholder:text-text-subtle focus:border-primary focus:outline-none transition-colors"
                />
              </div>
            </div>

            <!-- Phone and Location -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="rfq-phone" class="block text-xs font-mono uppercase tracking-wider text-text-muted mb-1.5 font-semibold">
                  Phone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="rfq-phone"
                  name="phone"
                  required
                  placeholder="e.g. +91 98250 12345"
                  class="w-full px-3.5 py-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle text-white text-xs placeholder:text-text-subtle focus:border-primary focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="rfq-location" class="block text-xs font-mono uppercase tracking-wider text-text-muted mb-1.5 font-semibold">
                  Plant / Delivery City *
                </label>
                <input
                  type="text"
                  id="rfq-location"
                  name="location"
                  required
                  placeholder="e.g. Umreth / Anand / V.V. Nagar"
                  class="w-full px-3.5 py-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle text-white text-xs placeholder:text-text-subtle focus:border-primary focus:outline-none transition-colors"
                />
              </div>
            </div>

            <!-- Requirements Details -->
            <div>
              <label for="rfq-details" class="block text-xs font-mono uppercase tracking-wider text-text-muted mb-1.5 font-semibold">
                Technical Requirements / Specifications
              </label>
              <textarea
                id="rfq-details"
                name="details"
                rows="3"
                placeholder="Specify gas type and flow rate, weighbridge tonnage (e.g. 60T/100T pitless), or software automation requirements..."
                class="w-full px-3.5 py-2.5 rounded-[var(--radius-md)] bg-[#030712] border border-border-subtle text-white text-xs placeholder:text-text-subtle focus:border-primary focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
              <Button
                type="submit"
                variant="primary"
                size="md"
                class="w-full sm:w-auto px-6 py-2.5 text-xs font-semibold"
              >
                <svg
                  slot="icon-left"
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 fill-current"
                  viewBox="0 0 24 24"
                >
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                </svg>
                <span>Request on WhatsApp</span>
              </Button>

              <Button
                href={`tel:${businessProfile.contact.phone.replace(/[^0-9+]/g, '')}`}
                variant="secondary"
                size="md"
                class="w-full sm:w-auto px-6 py-2.5 text-xs font-semibold border-border hover:border-primary/50"
              >
                <svg
                  slot="icon-left"
                  class="h-4 w-4 text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>Call Engineering Team</span>
              </Button>
            </div>
          </form>
        </GlassCard>
      </div>
    </div>
  </Container>
</section>

<script>
  function initRfqForm() {
    const form = document.getElementById('rfq-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const rawDivisions = formData.getAll('division');
      const divisions = rawDivisions.join(', ') || 'General Inquiry';
      const name = formData.get('name') as string;
      const company = formData.get('company') as string;
      const phone = formData.get('phone') as string;
      const location = formData.get('location') as string;
      const details = (formData.get('details') as string) || 'No extra notes specified.';

      const message = `*B2B INQUIRY — BURHANI ENTERPRISE*\n\n` +
        `• *Division(s):* ${divisions}\n` +
        `• *Contact Name:* ${name}\n` +
        `• *Company:* ${company}\n` +
        `• *Phone:* ${phone}\n` +
        `• *Plant Location:* ${location}\n` +
        `• *Requirements:* ${details}\n\n` +
        `Please provide technical consultation and formal quotation.`;

      let whatsappNumber = '919998450711';
      if (rawDivisions.includes('weighing') && !rawDivisions.includes('gas')) {
        whatsappNumber = '919974164452';
      } else if (rawDivisions.includes('software') && !rawDivisions.includes('gas') && !rawDivisions.includes('weighing')) {
        whatsappNumber = '919574713452';
      }

      const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank');
    });
  }

  document.addEventListener('DOMContentLoaded', initRfqForm);
  document.addEventListener('astro:page-load', initRfqForm);
</script>
