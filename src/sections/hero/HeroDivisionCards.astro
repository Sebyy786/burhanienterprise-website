---
import GlassCard from '../../components/ui/GlassCard.astro';
import Badge from '../../components/ui/Badge.astro';

interface DivisionItem {
  id: string;
  title: string;
  badge: string;
  description: string;
  specs: string[];
  image: string;
  imageAlt: string;
}

const divisions: DivisionItem[] = [
  {
    id: 'gas-solutions',
    title: 'Gas Solutions',
    badge: 'Commercial LPG & Pipelines',
    description:
      'LPG cylinder manifold installations, kitchen pipelines, and safety brass regulators for restaurants, hotels, and local manufacturing units.',
    specs: ['LPG Cylinder Manifold Banks', 'Commercial Kitchen Pipelines', 'Brass Pressure Regulators'],
    image: '/images/gas-solutions.jpg',
    imageAlt: 'Burhani Enterprise Commercial LPG Cylinder Manifold Installation in Gujarat',
  },
  {
    id: 'weighing-solutions',
    title: 'Weighing Solutions',
    badge: 'Commercial Weighbridges',
    description:
      'Heavy-duty pit and pitless truck weighbridges, warehouse platform scales, and precision digital load cells for mills, warehouses, and factories.',
    specs: ['Truck & Pitless Weighbridges', 'Warehouse Platform Scales', 'Digital Load Cells & Indicators'],
    image: '/images/weighing-solutions.jpg',
    imageAlt: 'Burhani Enterprise Pitless Truck Weighbridge Platform Scale in Anand District',
  },
  {
    id: 'software-solutions',
    title: 'Software Solutions',
    badge: 'Weighbridge & Business IT',
    description:
      'Burhani Weighbridge Management Software, automated weighment slip printing, CCTV snapshots, and custom business IT solutions.',
    specs: ['Weighbridge Automation Software', 'Fast Weighment Slip Printing', 'Custom ERP & Tally Integration'],
    image: '/images/software-solutions.jpg',
    imageAlt: 'Burhani Enterprise Weighbridge Management Automation Software UI',
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 w-full max-w-6xl mx-auto select-none">
  {
    divisions.map((division, index) => (
      <GlassCard
        as="article"
        padding="md"
        hoverEffect={true}
        class="flex flex-col justify-between group border-border/70 hover:border-primary/50 transition-all duration-300"
      >
        <div>
          <!-- Real Product Photography Chamber -->
          <div class="relative w-full h-48 rounded-[var(--radius-lg)] bg-[#050c20] border border-border-subtle overflow-hidden mb-5 group-hover:border-primary/40 transition-colors">
            <img
              src={division.image}
              alt={division.imageAlt}
              width="600"
              height="380"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />

            <!-- Subtle Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a1128] via-[#0a1128]/35 to-transparent pointer-events-none" />

            <!-- Division Index Indicator Badge -->
            <div class="absolute top-3 left-3 z-10">
              <span class="text-[10px] font-mono tracking-widest text-primary/90 bg-[#030712]/80 px-2 py-0.5 rounded border border-primary/30 backdrop-blur-xs">
                DIV-0{index + 1}
              </span>
            </div>

            <!-- Division Category Badge -->
            <div class="absolute bottom-3 right-3 z-10">
              <Badge variant="navy" size="sm" class="bg-[#030712]/85 border-border text-text-gold backdrop-blur-xs">
                {division.badge}
              </Badge>
            </div>
          </div>

          <!-- Card Header & Title -->
          <h2 class="text-h3 text-white font-heading font-semibold mb-2 group-hover:text-primary transition-colors">
            {division.title}
          </h2>

          <p class="text-sm text-text-muted mb-4 leading-relaxed font-body">
            {division.description}
          </p>
        </div>

        <!-- Specifications List & Micro Link -->
        <div class="pt-4 border-t border-border-subtle">
          <ul class="space-y-1.5 text-xs text-text-subtle font-body mb-4">
            {division.specs.map((spec) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-primary/70" aria-hidden="true" />
                <span>{spec}</span>
              </li>
            ))}
          </ul>

          <a
            href={`#${division.id}`}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary-hover tracking-wide font-heading uppercase group/link"
          >
            <span>Explore Division Specs</span>
            <svg
              class="h-3.5 w-3.5 transition-transform duration-200 group-hover/link:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </GlassCard>
    ))
  }
</div>
