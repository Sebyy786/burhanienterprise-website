---
import Badge from '../../components/ui/Badge.astro';
import HeroCTA from './HeroCTA.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<div class={`text-center max-w-4xl mx-auto flex flex-col items-center font-gujarati ${className}`}>
  <!-- Trust Header Badge -->
  <div class="mb-5 inline-flex items-center justify-center max-w-full px-2">
    <Badge variant="gold" size="md" class="max-w-full text-center">
      <span class="text-[9px] sm:text-xs text-center leading-tight tracking-wider uppercase">GSTIN: 24BZQPR2070B1ZG</span>
    </Badge>
  </div>

  <!-- Authentic Gujarati & English Wordmark Subheading -->
  <span
    class="text-xs sm:text-sm font-heading font-semibold text-text-gold tracking-widest uppercase mb-3 block"
    data-i18n-gu="બુરહાની એન્ટરપ્રાઇઝ • BURHANI ENTERPRISE"
    data-i18n-en="BURHANI ENTERPRISE"
  >
    બુરહાની એન્ટરપ્રાઇઝ • BURHANI ENTERPRISE
  </span>

  <!-- Hero Primary Headline with Fluid Typography & Luxury Gold Gradient -->
  <h1
    class="text-[1.45rem] sm:text-3xl md:text-4xl lg:text-[3.25rem] font-heading font-bold tracking-tight text-white mb-6 max-w-3xl leading-[1.25] sm:leading-[1.2] lg:leading-[1.18] break-words text-center"
  >
    <span
      class="gold-gradient-text"
      data-i18n-gu="ઔદ્યોગિક અને વ્યાપારી સોલ્યુશન્સ"
      data-i18n-en="Industrial & Commercial Solutions"
    >ઔદ્યોગિક અને વ્યાપારી સોલ્યુશન્સ</span>
  </h1>

  <!-- Hero Subtitle / Value Proposition -->
  <p
    class="text-base sm:text-body-lg text-text-muted max-w-2xl mb-8 sm:mb-9 leading-relaxed font-body"
    data-i18n-gu="બુરહાની એન્ટરપ્રાઇઝ: કોમર્શિયલ LPG પાઇપલાઇન, દરેક પ્રકારના ગેસ સ્ટવ, તમામ સ્પેરપાર્ટ્સ અને સંતોષકારક રિપેરિંગ • ડિજિટલ વજન કાંટા, વેઇબ્રિજ, સ્ટેમ્પિંગ સહાય • AI અને કસ્ટમ સોફ્ટવેર ઓટોમેશન."
    data-i18n-en="Burhani Enterprise: Commercial LPG pipelines, all types of gas stoves, spare parts & expert servicing • Digital weighing scales, weighbridges, stamping assistance • AI & custom software automation."
  >
    બુરહાની એન્ટરપ્રાઇઝ: કોમર્શિયલ LPG પાઇપલાઇન, દરેક પ્રકારના ગેસ સ્ટવ, તમામ સ્પેરપાર્ટ્સ અને સંતોષકારક રિપેરિંગ • ડિજિટલ વજન કાંટા, વેઇબ્રિજ, સ્ટેમ્પિંગ સહાય • AI અને કસ્ટમ સોફ્ટવેર ઓટોમેશન.
  </p>

  <!-- Dual Action CTAs -->
  <HeroCTA class="mb-8 sm:mb-10" />

  <!-- Trust Micro-Badges -->
  <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-text-subtle select-none">
    <div class="inline-flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span
        data-i18n-gu="LPG ગેસ પાઇપલાઇન &amp; સ્ટવ રિપેરિંગ"
        data-i18n-en="LPG Gas Pipelines &amp; Stove Repairs"
      >LPG ગેસ પાઇપલાઇન &amp; સ્ટવ રિપેરિંગ</span>
    </div>
    <span class="hidden sm:inline text-border">•</span>
    <div class="inline-flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
      </svg>
      <span
        data-i18n-gu="ડિજિટલ વજન કાંટા &amp; વેઇબ્રિજ"
        data-i18n-en="Digital Scales &amp; Weighbridges"
      >ડિજિટલ વજન કાંટા &amp; વેઇબ્રિજ</span>
    </div>
    <span class="hidden sm:inline text-border">•</span>
    <div class="inline-flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      <span
        data-i18n-gu="AI ઓટોમેશન &amp; કસ્ટમ સોફ્ટવેર"
        data-i18n-en="AI Automation &amp; Custom Software"
      >AI ઓટોમેશન &amp; કસ્ટમ સોફ્ટવેર</span>
    </div>
  </div>
</div>
