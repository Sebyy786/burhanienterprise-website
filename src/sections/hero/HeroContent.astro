---
import Badge from '../../components/ui/Badge.astro';
import HeroCTA from './HeroCTA.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<div class={`text-center max-w-4xl mx-auto flex flex-col items-center ${className}`}>
  <!-- Trust Header Badge -->
  <div class="mb-6 inline-flex items-center justify-center max-w-full px-2">
    <Badge variant="gold" size="md" class="max-w-full text-center">
      <span class="text-[9px] sm:text-xs text-center leading-tight">Gas Systems • Weighing Automation • Enterprise Software</span>
    </Badge>
  </div>

  <!-- Hero Primary Headline with Fluid Typography & Luxury Gold Gradient -->
  <h1
    class="text-[1.35rem] sm:text-3xl md:text-4xl lg:text-[3.25rem] font-heading font-bold tracking-tight text-white mb-6 max-w-3xl leading-[1.22] sm:leading-[1.18] lg:leading-[1.15] break-words text-center"
  >
    <span>Industrial Reliability.</span>
    <br />
    <span class="gold-gradient-text font-serif italic tracking-normal">Engineering Excellence.</span>
  </h1>

  <!-- Hero Subtitle / Value Proposition -->
  <p class="text-base sm:text-body-lg text-text-muted max-w-2xl mb-8 sm:mb-9 leading-relaxed font-body">
    Burhani Enterprise delivers specialized industrial gas distribution systems, high-capacity
    weighing solutions, and tailor-made enterprise software designed for operational precision
    and dependability.
  </p>

  <!-- Dual Action CTAs -->
  <HeroCTA class="mb-8 sm:mb-10" />

  <!-- Trust Micro-Badges (Non-fabricated) -->
  <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-text-subtle select-none">
    <div class="inline-flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Engineered Gas Manifolds</span>
    </div>
    <span class="hidden sm:inline text-border">•</span>
    <div class="inline-flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
      </svg>
      <span>Precision Weighbridge Systems</span>
    </div>
    <span class="hidden sm:inline text-border">•</span>
    <div class="inline-flex items-center gap-1.5">
      <svg class="h-4 w-4 text-primary/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
      <span>Custom Software & ERP Integration</span>
    </div>
  </div>
</div>
