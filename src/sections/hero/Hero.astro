---
import Container from '../../components/ui/Container.astro';

const bannerImages = [
  {
    src: '/images/banner/banner-1.jpg',
    alt: 'Burhani Enterprise - Weighing Scales & Gas Stoves Showroom Board',
    title: 'Weighing Scales & Gas Solutions',
  },
  {
    src: '/images/banner/banner-2.jpg',
    alt: 'Burhani Enterprise - AI, Software & Automation Solutions',
    title: 'Software & AI Automation',
  },
];
---

<section
  id="hero"
  class="relative pt-4 sm:pt-6 pb-12 sm:pb-16 bg-[#020614] overflow-hidden"
  aria-label="Burhani Enterprise Hero"
>
  <Container size="xl" class="flex flex-col gap-6 sm:gap-8">
    <!-- Hero Text Only (Simplified Promotional Header) -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center gap-2 sm:gap-3 font-gujarati">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold tracking-tight text-white">
        <span class="gold-gradient-text" data-i18n-gu="બુરહાની એન્ટરપ્રાઈઝ" data-i18n-en="Burhani Enterprise">
          Burhani Enterprise
        </span>
      </h1>

      <p
        class="text-sm sm:text-lg lg:text-xl font-heading font-semibold text-slate-200 tracking-wide"
        data-i18n-gu="વજન કાંટા • ગેસ એપ્લાયન્સિસ • સોફ્ટવેર સોલ્યુશન્સ"
        data-i18n-en="Weighing Scales • Gas Appliances • Software Solutions"
      >
        Weighing Scales • Gas Appliances • Software Solutions
      </p>

      <div class="flex items-center gap-2 text-xs sm:text-sm font-mono uppercase tracking-widest text-text-gold font-bold">
        <span data-i18n-gu="વેચાણ • સર્વિસ • રિપેરિંગ" data-i18n-en="Sales • Service • Repair">
          Sales • Service • Repair
        </span>
      </div>

      <p
        class="text-xs sm:text-sm text-text-muted font-body"
        data-i18n-gu="ઉમરેઠ અને આણંદ જિલ્લામાં સેવા ઉપલબ્ધ."
        data-i18n-en="Serving Umreth &amp; Anand District."
      >
        Serving Umreth &amp; Anand District.
      </p>
    </div>

    <!-- Full-Width Banner Carousel (Embla Carousel, 5s Autoplay, Swipe, Arrows, Dots) -->
    <div class="relative w-full rounded-2xl overflow-hidden border-2 border-primary/30 shadow-2xl bg-[#03081a] select-none group">
      <!-- Embla Viewport -->
      <div class="embla overflow-hidden cursor-grab active:cursor-grabbing" id="hero-banner-viewport">
        <div class="embla__container flex">
          {
            bannerImages.map((banner, index) => (
              <div class="embla__slide flex-[0_0_100%] min-w-0 relative">
                <div class="relative w-full h-[240px] sm:h-[340px] md:h-[400px] lg:h-[460px] bg-[#020512] flex items-center justify-center overflow-hidden p-2 sm:p-4">
                  <img
                    src={banner.src}
                    alt={banner.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="max-w-full max-h-full w-auto h-auto object-contain object-center select-none"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Previous Arrow -->
      <button
        type="button"
        id="hero-banner-prev"
        aria-label="Previous Banner"
        class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-[#020614]/80 hover:bg-primary text-text-muted hover:text-[#030712] border border-primary/40 flex items-center justify-center transition-all cursor-pointer shadow-xl active:scale-95 z-20 opacity-80 hover:opacity-100"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Next Arrow -->
      <button
        type="button"
        id="hero-banner-next"
        aria-label="Next Banner"
        class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 rounded-full bg-[#020614]/80 hover:bg-primary text-text-muted hover:text-[#030712] border border-primary/40 flex items-center justify-center transition-all cursor-pointer shadow-xl active:scale-95 z-20 opacity-80 hover:opacity-100"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Indicator Dots -->
      <div class="absolute bottom-3 inset-x-0 flex items-center justify-center gap-2 z-20" id="hero-banner-dots">
        {
          bannerImages.map((_, index) => (
            <button
              type="button"
              class:list={[
                'hero-dot w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer border border-primary/60',
                index === 0 ? 'bg-primary w-6' : 'bg-white/40 hover:bg-white/70',
              ]}
              data-slide-index={index}
              aria-label={`Go to slide ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initHeroBanner() {
    const emblaNode = document.getElementById('hero-banner-viewport');
    if (!emblaNode) return;

    const prevBtn = document.getElementById('hero-banner-prev');
    const nextBtn = document.getElementById('hero-banner-next');
    const dots = document.querySelectorAll('.hero-dot');

    const autoplay = Autoplay({
      delay: 5000,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
    });

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: 'start',
        skipSnaps: false,
      },
      [autoplay]
    );

    function updateDots() {
      const selectedIndex = emblaApi.selectedScrollSnap();
      dots.forEach((dot, index) => {
        if (index === selectedIndex) {
          dot.classList.add('bg-primary', 'w-6');
          dot.classList.remove('bg-white/40');
        } else {
          dot.classList.remove('bg-primary', 'w-6');
          dot.classList.add('bg-white/40');
        }
      });
    }

    emblaApi.on('select', updateDots);
    emblaApi.on('init', updateDots);

    prevBtn?.addEventListener('click', () => emblaApi.scrollPrev());
    nextBtn?.addEventListener('click', () => emblaApi.scrollNext());

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => emblaApi.scrollTo(index));
    });
  }

  initHeroBanner();
  document.addEventListener('astro:page-load', initHeroBanner);
</script>
