---
import Container from '../../components/ui/Container.astro';
import HeroBackground from './HeroBackground.astro';
import Badge from '../../components/ui/Badge.astro';
import { businessProfile } from '../../data/business';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<section
  id="hero"
  class={`relative flex flex-col justify-start pt-6 pb-16 sm:pt-10 sm:pb-20 lg:pt-12 lg:pb-24 overflow-hidden ${className}`}
  aria-label="બુરહાની એન્ટરપ્રાઇઝ મુખ્ય વિભાગ"
>
  <!-- Cinematic Ambient Background -->
  <HeroBackground />

  <Container size="xl" class="relative z-10 flex flex-col items-center gap-8 sm:gap-12">
    <!-- Top Trust Header Badge -->
    <div class="text-center max-w-4xl mx-auto flex flex-col items-center font-gujarati">
      <div class="mb-4 inline-flex items-center justify-center">
        <Badge variant="gold" size="md">
          <span
            class="text-[10px] sm:text-xs font-mono font-bold tracking-wider uppercase text-center"
            data-i18n-gu="ઉમરેઠ, આણંદ, વલ્લભ વિદ્યાનગર, પેટલાદ, બોરસદ અને નજીકના વિસ્તારોમાં સેવા ઉપલબ્ધ."
            data-i18n-en="Serving Umreth, Anand, Vallabh Vidyanagar, Petlad, Borsad and nearby areas in Anand District."
          >
            ઉમરેઠ, આણંદ, વલ્લભ વિદ્યાનગર, પેટલાદ, બોરસદ અને નજીકના વિસ્તારોમાં સેવા ઉપલબ્ધ.
          </span>
        </Badge>
      </div>

      <!-- Primary Headline -->
      <h1
        class="text-3xl sm:text-5xl lg:text-6xl font-heading font-bold tracking-tight text-white mb-3 max-w-4xl leading-tight text-center"
      >
        <span
          class="gold-gradient-text"
          data-i18n-gu="બુરહાની એન્ટરપ્રાઈઝ"
          data-i18n-en="Burhani Enterprise"
        >
          બુરહાની એન્ટરપ્રાઈઝ
        </span>
      </h1>

      <!-- Subtitle -->
      <p
        class="text-base sm:text-xl font-heading font-semibold text-slate-200 tracking-wide mb-2 text-center"
        data-i18n-gu="વજન કાંટા • ગેસ એપ્લાયન્સિસ • સોફ્ટવેર સોલ્યુશન્સ"
        data-i18n-en="Weighing Scales • Gas Appliances • Software Solutions"
      >
        વજન કાંટા • ગેસ એપ્લાયન્સિસ • સોફ્ટવેર સોલ્યુશન્સ
      </p>

      <!-- Tagline -->
      <p
        class="text-xs sm:text-sm font-mono uppercase tracking-widest text-text-gold font-bold mb-4 text-center"
        data-i18n-gu="વેચાણ • સર્વિસ • રિપેરિંગ"
        data-i18n-en="Sales • Service • Repair"
      >
        વેચાણ • સર્વિસ • રિપેરિંગ
      </p>

      <!-- Value Proposition / Context -->
      <p
        class="text-xs sm:text-sm text-text-muted max-w-2xl mb-6 leading-relaxed font-body text-center"
        data-i18n-gu="અધિકૃત ડિજિટલ વજન કાંટા, કેલિબ્રેશન અને લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ સહાય, કોમર્શિયલ ગેસ પાઇપલાઇન, સ્ટવ રિપેરિંગ અને આધુનિક વેઇબ્રિજ/AI સોફ્ટવેર સોલ્યુશન્સ."
        data-i18n-en="Authorized commercial weighing scales with calibration &amp; legal metrology stamping assistance, commercial LPG pipelines, stove repairs, and modern weighbridge &amp; AI software solutions."
      >
        અધિકૃત ડિજિટલ વજન કાંટા, કેલિબ્રેશન અને લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ સહાય, કોમર્શિયલ ગેસ પાઇપલાઇન, સ્ટવ રિપેરિંગ અને આધુનિક વેઇબ્રિજ/AI સોફ્ટવેર સોલ્યુશન્સ.
      </p>

      <!-- Quick Category Jump Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="#scales"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-[#030712] font-heading font-bold text-xs shadow-[0_0_20px_rgba(212,175,55,0.35)] hover:brightness-110 transition-all"
        >
          <span>⚖️</span>
          <span data-i18n-gu="વજન કાંટા (Scales)" data-i18n-en="Weighing Scales">વજન કાંટા (Scales)</span>
        </a>

        <a
          href="#gas"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#05112e] text-white border border-primary/40 hover:border-primary font-heading font-bold text-xs transition-all"
        >
          <span>🔥</span>
          <span data-i18n-gu="ગેસ પ્રોડક્ટ્સ (Gas)" data-i18n-en="Gas Products">ગેસ પ્રોડક્ટ્સ (Gas)</span>
        </a>

        <a
          href="#software"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#05112e] text-white border border-indigo-500/40 hover:border-indigo-400 font-heading font-bold text-xs transition-all"
        >
          <span>💻</span>
          <span data-i18n-gu="સોફ્ટવેર &amp; AI" data-i18n-en="Software &amp; AI">સોફ્ટવેર &amp; AI</span>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-emerald-600/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-600/30 font-heading font-bold text-xs transition-all"
        >
          <span>📍</span>
          <span data-i18n-gu="સંપર્ક &amp; સરનામું" data-i18n-en="Contact &amp; Address">સંપર્ક &amp; સરનામું</span>
        </a>
      </div>
    </div>

    <!-- Authentic Local Scale Hero Showcase Card (Replacing Stock Imagery) -->
    <div class="w-full max-w-5xl mx-auto font-gujarati">
      <div class="relative rounded-2xl overflow-hidden border-2 border-primary/40 shadow-[0_20px_60px_rgba(0,0,0,0.85)] bg-gradient-to-b from-[#06122d] to-[#020512]">
        <!-- Gold Top Accent Border Line -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-primary to-transparent z-20" aria-hidden="true"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
          <!-- Left: Authentic Scale Photo -->
          <div class="lg:col-span-7 relative h-[280px] sm:h-[380px] lg:h-[420px] bg-[#01040f] p-4 sm:p-6 flex items-center justify-center overflow-hidden group">
            <img
              src="/images/scale/scale-2.jpg"
              alt="બુરહાની એન્ટરપ્રાઇઝ ડિજિટલ વજન કાંટા અને કેલિબ્રેશન સેવા"
              loading="eager"
              decoding="async"
              class="max-w-full max-h-full object-contain rounded-xl shadow-2xl transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute top-4 left-4 z-10">
              <span class="text-[11px] font-mono font-bold px-3 py-1 rounded-full bg-[#020512]/90 text-primary border border-primary/50 backdrop-blur-md shadow-lg">
                ઓરિજિનલ પ્રોડક્ટ ફોટો • લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ સહાય
              </span>
            </div>
          </div>

          <!-- Right: Business Highlights & Direct Contacts -->
          <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between h-full border-t lg:border-t-0 lg:border-l border-primary/20">
            <div>
              <span class="text-[11px] font-mono uppercase tracking-wider text-text-gold font-semibold block mb-1">
                વિશ્વસનીય સ્થાનિક સેવા • ઉમરેઠ
              </span>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-3">
                ડિજિટલ વજન કાંટા, ગેસ સોલ્યુશન્સ &amp; AI
              </h2>
              <p class="text-xs text-text-muted leading-relaxed mb-4">
                બુરહાની એન્ટરપ્રાઇઝ દ્વારા ઉમરેઠ તથા નજીકના વિસ્તારોમાં અધિકૃત વેચાણ, ઓરિજિનલ સ્પેરપાર્ટ્સ અને સંતોષકારક ટેકનિકલ રિપેરિંગ સેવા.
              </p>

              <!-- Highlights Bullet List -->
              <ul class="space-y-2 text-xs text-slate-200 mb-6">
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">✓</span>
                  <span>લાગુ પડતા લીગલ મેટ્રોલોજી નિયમો અનુસાર કેલિબ્રેશન અને સરકારી સ્ટેમ્પિંગ સહાય ઉપલબ્ધ છે.</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">✓</span>
                  <span>દરેક પ્રકારના ગેસ સ્ટવ, હોટલ પાઇપલાઇન &amp; તમામ સ્પેરપાર્ટ્સ</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-primary font-bold">✓</span>
                  <span>AI ઓટોમેશન સોલ્યુશન્સ &amp; વેઇબ્રિજ સ્લિપ પ્રિન્ટિંગ સોફ્ટવેર</span>
                </li>
              </ul>
            </div>

            <!-- Direct WhatsApp Contacts -->
            <div class="space-y-2.5 pt-4 border-t border-border-subtle">
              <div class="text-[11px] font-mono text-text-subtle uppercase">વિભાગ વડાઓનો સીધો સંપર્ક:</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <a
                  href={businessProfile.divisionContacts.weighing.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-2 rounded-lg bg-[#04091a] border border-border-subtle hover:border-primary/60 text-xs font-semibold text-white transition-colors"
                >
                  <div>
                    <div class="text-white text-[11px] font-bold">હોઝેફા રંગવાલા</div>
                    <div class="text-[9px] text-text-gold font-mono">વજન કાંટા • {businessProfile.divisionContacts.weighing.phone}</div>
                  </div>
                  <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[9px] font-mono">WhatsApp</span>
                </a>

                <a
                  href={businessProfile.divisionContacts.gas.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-2 rounded-lg bg-[#04091a] border border-border-subtle hover:border-primary/60 text-xs font-semibold text-white transition-colors"
                >
                  <div>
                    <div class="text-white text-[11px] font-bold">બુરહાનુદ્દીન રંગવાલા</div>
                    <div class="text-[9px] text-text-gold font-mono">ગેસ સર્વિસ • {businessProfile.divisionContacts.gas.phone}</div>
                  </div>
                  <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[9px] font-mono">WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
