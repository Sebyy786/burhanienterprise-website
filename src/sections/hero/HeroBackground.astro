---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props as Props;
---

<div
  class={`pointer-events-none absolute inset-0 -z-10 overflow-hidden select-none ${className}`}
  aria-hidden="true"
>
  <!-- Base Dark Navy Radial Backdrop -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-10%,_#0a1f4a_0%,_#061026_50%,_#030712_100%)]"
  ></div>

  <!-- Primary Gold Ambient Glow Orb (Centered Top) -->
  <div
    class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[450px] rounded-full bg-[radial-gradient(circle,_rgba(212,175,55,0.18)_0%,_rgba(212,175,55,0.03)_50%,_transparent_75%)] blur-3xl opacity-75"
  ></div>

  <!-- Secondary Deep Navy Ambient Glow (Right) -->
  <div
    class="absolute top-1/3 -right-32 w-[550px] h-[550px] rounded-full bg-[radial-gradient(circle,_rgba(0,31,84,0.35)_0%,_transparent_70%)] blur-3xl opacity-60"
  ></div>

  <!-- Tertiary Subtle Gold Rim Glow (Left Bottom) -->
  <div
    class="absolute bottom-10 -left-20 w-[450px] h-[450px] rounded-full bg-[radial-gradient(circle,_rgba(170,124,17,0.12)_0%,_transparent_70%)] blur-3xl opacity-50"
  ></div>

  <!-- Engineering Blueprint Grid Pattern -->
  <svg
    class="absolute inset-0 h-full w-full stroke-primary/10 [mask-image:radial-gradient(100%_100%_at_top_center,white,transparent)]"
    aria-hidden="true"
  >
    <defs>
      <pattern id="hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M.5 48V.5H48" fill="none" stroke-dasharray="2 4" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" stroke-width="0" fill="url(#hero-grid)" />
  </svg>

  <!-- Top Hairline Gold Horizon Divider -->
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/35 to-transparent"
  ></div>

  <!-- Bottom Smooth Fading Mask into Content Canvas -->
  <div
    class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-background to-transparent"
  ></div>
</div>
