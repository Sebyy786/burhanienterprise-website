---
import Button from '../../components/ui/Button.astro';

interface Props {
  class?: string;
  quoteHref?: string;
  catalogHref?: string;
}

const {
  class: className = '',
  quoteHref = '#contact',
  catalogHref = '#divisions',
} = Astro.props as Props;
---

<div class={`flex flex-col sm:flex-row items-center justify-center gap-4 ${className}`}>
  <!-- Primary B2B Action Button -->
  <Button
    href={quoteHref}
    variant="primary"
    size="lg"
    class="w-full sm:w-auto px-8 py-4 text-base font-semibold shadow-[0_4px_24px_rgba(212,175,55,0.35)] hover:shadow-[0_8px_32px_rgba(212,175,55,0.5)] group"
  >
    <span>Request B2B Quote</span>
    <svg
      slot="icon-right"
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-1"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </Button>

  <!-- Secondary Product Catalog Action Button -->
  <Button
    href={catalogHref}
    variant="secondary"
    size="lg"
    class="w-full sm:w-auto px-8 py-4 text-base border-border hover:border-primary/50 group"
  >
    <svg
      slot="icon-left"
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5 text-primary/80 transition-transform duration-200 group-hover:scale-110"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
      />
    </svg>
    <span>Explore Product Divisions</span>
  </Button>
</div>
