            data-i18n-en="Transparency Disclaimer • Visual Notice"
          >
            પારદર્શિતા ડિસ્ક્લેમર • ફોટોગ્રાફી નોંધ
          </span>
        </div>
        <p
          class="text-[11.5px] sm:text-xs text-text-muted leading-relaxed font-body"
          data-i18n-gu="અમારા લોખંડ બજાર (ઉમરેઠ) સ્થિત શોરૂમ અને વર્કશોપની વાસ્તવિક ઓન-સાઇટ ફોટોગ્રાફી અપડેટ થઈ રહી છે ત્યાં સુધી આ સેક્શનમાં દર્શાવેલ અમુક શોરૂમ તસવીરો પ્રતીકાત્મક (AI-જનરેટેડ) છે. અમારા તમામ ઉત્પાદનો, વાસ્તવિક સ્ટોક અને અધિકૃત સેવાઓ માટે આપનું અમારી દુકાને રૂબરૂ સ્વાગત છે."
          data-i18n-en="While our authentic on-site shop photography is being finalized, please note that certain showroom visuals above are illustrative placeholders generated using AI. All products, genuine spare parts, and authorized repair services represent our real physical store in Lokhand Bazar, Umreth. We warmly invite you to visit us in person."
        >
          અમારા લોખંડ બજાર (ઉમરેઠ) સ્થિત શોરૂમ અને વર્કશોપની વાસ્તવિક ઓન-સાઇટ ફોટોગ્રાફી અપડેટ થઈ રહી છે ત્યાં સુધી આ સેક્શનમાં દર્શાવેલ અમુક શોરૂમ તસવીરો પ્રતીકાત્મક (AI-જનરેટેડ) છે. અમારા તમામ ઉત્પાદનો, વાસ્તવિક સ્ટોક અને અધિકૃત સેવાઓ માટે આપનું અમારી દુકાને રૂબરૂ સ્વાગત છે.
        </p>
      </div>
    </div>
  </Container>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initShopGallery() {
    const emblaNode = document.getElementById('shop-gallery-viewport');
    if (!emblaNode) return;

    const prevBtn = document.getElementById('shop-gallery-prev');
    const nextBtn = document.getElementById('shop-gallery-next');
    const dots = document.querySelectorAll('.shop-dot');

    const autoplay = Autoplay({
      delay: 4500,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
    });

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: 'start',
        slidesToScroll: 1,
        skipSnaps: false,
      },
      [autoplay]
    );

    function updateDots() {
      const selectedIndex = emblaApi.selectedScrollSnap();
      dots.forEach((dot, index) => {
        if (index === selectedIndex) {
          dot.classList.add('bg-primary', 'w-6');
          dot.classList.remove('bg-white/30', 'w-2');
        } else {
          dot.classList.remove('bg-primary', 'w-6');
          dot.classList.add('bg-white/30', 'w-2');
        }
      });
    }

    emblaApi.on('select', updateDots);
    emblaApi.on('init', updateDots);

    prevBtn?.addEventListener('click', () => emblaApi.scrollPrev());
    nextBtn?.addEventListener('click', () => emblaApi.scrollNext());

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => emblaApi.scrollTo(index));
    });
  }

  initShopGallery();
  document.addEventListener('astro:page-load', initShopGallery);
</script>
