                    <span class="text-[11px] font-mono text-emerald-400 font-semibold">૧૦૦% ઓરિજિનલ</span>
                    <a
                      href={`https://wa.me/${businessProfile.divisionContacts.gas.phoneDigits}?text=${encodeURIComponent(item.whatsappMsg)}`}
