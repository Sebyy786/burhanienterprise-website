        <div class="bg-[#020512] rounded-xl p-5 border border-emerald-500/40 shrink-0 flex flex-col gap-3 min-w-[260px] text-center sm:text-left shadow-xl">
          <div>
            <span class="text-[10px] font-mono uppercase text-text-subtle block" data-i18n-gu="ગેસ વિભાગ વડા" data-i18n-en="Gas Division Lead">ગેસ વિભાગ વડા</span>
            <span class="font-heading font-bold text-white text-base block">{businessProfile.divisionContacts.gas.name}</span>
            <span class="text-xs text-emerald-400 font-mono font-semibold">{businessProfile.divisionContacts.gas.phone}</span>
