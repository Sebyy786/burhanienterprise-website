<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initGasEmbla() {
    const emblaNode = document.getElementById('gas-embla-viewport');
    if (!emblaNode) return;

    const prevBtn = document.getElementById('gas-embla-prev');
    const nextBtn = document.getElementById('gas-embla-next');

    const autoplay = Autoplay({
      delay: 4500,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
    });

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: 'start',
        slidesToScroll: 1,
        skipSnaps: false,
      },
      [autoplay]
    );

    prevBtn?.addEventListener('click', () => emblaApi.scrollPrev());
    nextBtn?.addEventListener('click', () => emblaApi.scrollNext());
  }

  initGasEmbla();
  document.addEventListener('astro:page-load', initGasEmbla);
</script>
