                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#010617]/90 text-emerald-300 border border-emerald-500/40 backdrop-blur-md">
                          {item.badgeGu}
                        </span>
                      </div>
                      <div class="absolute bottom-2.5 right-2.5 z-10">
                        <span class="text-[10px] font-mono text-slate-300 bg-[#020512]/90 px-2 py-0.5 rounded border border-border-subtle backdrop-blur-sm">
