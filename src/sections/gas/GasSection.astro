                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-500 hover:text-slate-950 font-heading font-bold text-xs transition-all shrink-0 active:scale-95 shadow-sm"
                      aria-label={`Inquire about ${item.nameEn} on WhatsApp`}
                    >
                      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                      </svg>
                      <span>WhatsApp CTA</span>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- 2. Repair Services Block (6 Required Services) -->
    <div class="w-full flex flex-col gap-6 font-gujarati pt-2">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold block mb-1">
          Technical Capabilities &amp; Maintenance
        </span>
        <h3 class="text-xl sm:text-2xl font-heading font-bold text-white">
          ગેસ સ્ટવ &amp; ઇક્વિપમેન્ટ્સ રિપેરિંગ સેવાઓ (Repair Services)
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {
          repairServices.map((srv) => (
            <GlassCard padding="md" hoverEffect={true} class="flex flex-col justify-between border-border/80 bg-[#03091e] group">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d={srv.icon} />
                    </svg>
                  </div>
                  <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/30 font-semibold">
                    {srv.tagGu}
                  </span>
                </div>

                <h4 class="text-sm sm:text-base font-heading font-bold text-white mb-1 group-hover:text-emerald-300 transition-colors">
                  {srv.titleGu}
                </h4>
                <p class="text-[10px] text-text-gold font-mono mb-2">
                  {srv.titleEn}
                </p>
                <p class="text-xs text-text-muted leading-relaxed font-body">
                  {srv.descGu}
                </p>
              </div>

              <div class="pt-3 mt-3 border-t border-border-subtle/80 flex items-center justify-between text-[11px]">
                <span class="text-slate-300 font-mono">ઓરિજિનલ સ્પેરપાર્ટ્સ</span>
                <span class="text-emerald-400 font-semibold font-mono">100% Safe Work</span>
              </div>
            </GlassCard>
          ))
        }
      </div>
    </div>

    <!-- 3. Commercial LPG Pipeline Manifold & Direct Division Contact Box -->
    <div class="max-w-5xl mx-auto w-full font-gujarati">
      <div class="rounded-2xl bg-gradient-to-r from-[#030c24] via-[#051c3d] to-[#030c24] border-2 border-emerald-500/40 p-6 sm:p-8 lg:p-10 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="flex-1">
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#25D366]"></span>
            <span
              class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold"
              data-i18n-gu="કોમર્શિયલ LPG પાઇપલાઇન &amp; સર્વિસિંગ કન્સલ્ટેશન"
              data-i18n-en="Commercial LPG Pipeline &amp; Service Consultation"
            >
              કોમર્શિયલ LPG પાઇપલાઇન &amp; સર્વિસિંગ કન્સલ્ટેશન
            </span>
          </div>

          <h3
            class="text-lg sm:text-2xl font-heading font-bold text-white mb-2"
            data-i18n-gu="હોટલ, રેસ્ટોરન્ટ કે ફેક્ટરી માટે સુરક્ષિત ગેસ પાઇપલાઇન"
            data-i18n-en="Safe Commercial Gas Pipelines for Hotels, Restaurants &amp; Factories"
          >
            હોટલ, રેસ્ટોરન્ટ કે ફેક્ટરી માટે સુરક્ષિત ગેસ પાઇપલાઇન
          </h3>

          <p
            class="text-xs sm:text-sm text-text-muted leading-relaxed max-w-2xl"
            data-i18n-gu="તમારી સાઇટનું સર્વેક્ષણ, ડ્યુઅલ-સ્ટેજ પ્રેશર રેગ્યુલેશન, કોપર પિગટેલ, સેફ્ટી વાલ્વ્સ અને સંતોષકારક રિપેરિંગ માટે બુરહાનુદ્દીન રંગવાલાનો સીધો સંપર્ક કરો."
            data-i18n-en="Contact Burhanuddin Rangwala directly for site surveys, dual-stage pressure manifolds, copper pigtails, safety shutoffs, and reliable kitchen stove maintenance."
          >
            તમારી સાઇટનું સર્વેક્ષણ, ડ્યુઅલ-સ્ટેજ પ્રેશર રેગ્યુલેશન, કોપર પિગટેલ, સેફ્ટી વાલ્વ્સ અને સંતોષકારક રિપેરિંગ માટે બુરહાનુદ્દીન રંગવાલાનો સીધો સંપર્ક કરો.
          </p>
