---
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { businessProfile } from '../../data/business';
import { weighingProducts } from '../../data/weighing';
import { brandLogos } from '../../data/brands';

const scaleItems = weighingProducts;
const weighingLead = businessProfile.divisionContacts.weighing;

// Brand logos strictly limited to: Axpert, Rolex, Silver Eagle, Taj (logos only, no fake wording)
const partnerBrands = brandLogos.filter((b) =>
  ['brand-axpert', 'brand-rolex', 'brand-eagle', 'brand-taj'].includes(b.id)
);
---

<section
  id="scales"
  class="relative py-16 sm:py-24 bg-[#020614] border-t border-border-subtle overflow-hidden"
  aria-label="Section — Weighing Scales and Repair"
>
  <!-- Subtle Ambient Glow -->
  <div
    class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.07)_0%,transparent_70%)] blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-10 sm:gap-14">
    <!-- Header with Bilingual Titles, Short Description, and Carousel Navigation -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 font-gujarati">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-white tracking-tight mb-1">
          Weighing Scales &amp; Repair
        </h2>

        <p class="text-lg sm:text-xl font-heading font-bold gold-gradient-text mb-2">
          ડિજિટલ વજન કાંટા અને રિપેરિંગ
        </p>

        <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-body">
          દરેક પ્રકારના નવા ડિજિટલ વજન કાંટા, કાઉન્ટર સ્કેલ, પ્લેટફોર્મ અને પ્રિસિઝન સ્કેલ્સનું વેચાણ તેમજ સંતોષકારક રિપેરિંગ. સ્ટેમ્પિંગ સહાય અને ઓરિજિનલ સ્પેરપાર્ટ્સ હાજરમાં ઉપલબ્ધ.
        </p>
      </div>

      <!-- Carousel Navigation Arrows -->
      <div class="flex items-center gap-2 shrink-0 select-none">
        <button
          type="button"
          id="scale-embla-prev"
          aria-label="Previous scale"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-border bg-[#03081a] hover:border-primary hover:text-primary text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="scale-embla-next"
          aria-label="Next scale"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-border bg-[#03081a] hover:border-primary hover:text-primary text-text-muted flex items-center justify-center transition-all cursor-pointer shadow-lg active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Multi-Card Carousel: 4 desktop / 2 tablet / 1 mobile, Infinite Loop, Autoplay pause on hover -->
    <div class="w-full relative select-none">
      <div class="embla overflow-hidden cursor-grab active:cursor-grabbing" id="scale-embla-viewport">
        <div class="embla__container flex -ml-4 sm:-ml-5">
          {
            scaleItems.map((item, index) => (
              <div class="embla__slide flex-[0_0_100%] sm:flex-[0_0_50%] lg:flex-[0_0_25%] pl-4 sm:pl-5 min-w-0">
                <div class="h-full rounded-2xl bg-gradient-to-b from-[#071330] via-[#040c22] to-[#020614] border border-primary/25 hover:border-primary/60 shadow-xl hover:shadow-[0_12px_30px_rgba(212,175,55,0.15)] transition-all duration-300 flex flex-col justify-between p-4 sm:p-5 font-gujarati group/card">
                  <div>
                    <!-- Product Image Box -->
                    <div class="relative w-full aspect-[4/3] bg-[#01040f] rounded-xl overflow-hidden flex items-center justify-center p-3 mb-3.5 border border-border-subtle group-hover/card:border-primary/40 transition-colors">
                      <img
                        src={item.src}
                        alt={item.alt}
                        loading={index < 4 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover/card:scale-105"
                      />

                      <!-- Capacity Tag -->
                      {item.capacityGu && (
                        <div class="absolute top-2 right-2 z-10">
                          <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-[#020512]/90 text-primary border border-primary/40 backdrop-blur-md">
                            {item.capacityGu}
                          </span>
                        </div>
                      )}
                    </div>

                    <!-- Title -->
                    <h3 class="text-sm font-heading font-bold text-white mb-1 line-clamp-1 group-hover/card:text-primary transition-colors">
                      {item.nameGu}
                    </h3>

                    <!-- English Subtitle / Category -->
                    <p class="text-[11px] font-mono text-text-gold truncate mb-2">
                      {item.nameEn}
                    </p>

                    <!-- Short Description -->
                    <p class="text-xs text-text-muted line-clamp-2 font-body leading-relaxed mb-3">
                      {item.descGu}
                    </p>
                  </div>

                  <!-- Card Footer: Status & Direct Quote Button -->
                  <div class="pt-3 border-t border-border-subtle flex items-center justify-between gap-2">
                    <span class="text-[10px] font-mono text-emerald-400 font-semibold">
                      હાજરમાં સ્ટોક
                    </span>
                    <a
                      href={`https://wa.me/${weighingLead.phoneDigits}?text=${encodeURIComponent(item.whatsappMsg)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-primary hover:bg-primary-hover text-[#030712] font-heading font-bold text-xs shadow-md transition-all active:scale-95"
                      aria-label={`Inquire on WhatsApp about ${item.nameEn}`}
                    >
                      <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
                      </svg>
                      <span>Quote</span>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Clean Brand Strip (Logos Only: Axpert, Rolex, Silver Eagle, Taj - No fake wording) -->
    <div class="w-full flex flex-col items-center gap-3 pt-2">
      <div class="text-[11px] font-mono uppercase tracking-widest text-text-subtle font-semibold">
        Partner Brands
      </div>

      <div class="w-full max-w-4xl grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-5">
        {
          partnerBrands.map((b) => (
            <div class="flex items-center justify-center p-3 sm:p-4 rounded-xl bg-white/95 border border-white/20 shadow-md hover:scale-105 transition-transform">
              <img
                src={b.logo}
                alt={b.name}
                class="h-9 sm:h-11 w-auto max-w-[120px] object-contain"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Section Bottom Actions & Primary CTA (WhatsApp for Scale Inquiry routed to Hozefa) -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <Button
        href={weighingLead.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="lg"
        ariaLabel="WhatsApp for Scale Inquiry"
        class="shadow-xl shadow-primary/25"
      >
        <svg slot="icon-left" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>WhatsApp for Scale Inquiry</span>
      </Button>

      <a
        href="/weighing-scales"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-surface-soft hover:bg-surface-card border border-primary/40 text-xs font-semibold text-white transition-all shadow-md"
      >
        <span>Explore Digital Showroom</span>
        <span>→</span>
      </a>
    </div>
  </Container>
</section>

<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  function initScaleEmbla() {
    const emblaNode = document.getElementById('scale-embla-viewport');
    if (!emblaNode) return;

    const prevBtn = document.getElementById('scale-embla-prev');
    const nextBtn = document.getElementById('scale-embla-next');

    const autoplay = Autoplay({
      delay: 4500,
      stopOnInteraction: false,
      stopOnMouseEnter: true,
    });

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: 'start',
        slidesToScroll: 1,
        skipSnaps: false,
      },
      [autoplay]
    );

    prevBtn?.addEventListener('click', () => emblaApi.scrollPrev());
    nextBtn?.addEventListener('click', () => emblaApi.scrollNext());
  }

  initScaleEmbla();
  document.addEventListener('astro:page-load', initScaleEmbla);
</script>
