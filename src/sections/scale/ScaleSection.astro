            <span class="text-[10px] uppercase font-mono text-text-subtle block" data-i18n-gu="વિભાગ વડા" data-i18n-en="Division Lead">વિભાગ વડા</span>
            <span class="font-heading font-bold text-white text-sm block">{businessProfile.divisionContacts.weighing.name}</span>
            <span class="text-xs text-text-gold font-mono">{businessProfile.divisionContacts.weighing.phone}</span>
          </div>

          <Button
            href={businessProfile.divisionContacts.weighing.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="sm"
            class="w-full justify-center"
            ariaLabel="Contact Hozefa on WhatsApp"
          >
            <span data-i18n-gu="વોટ્સએપ સંપર્ક" data-i18n-en="WhatsApp Inquiry">વોટ્સએપ સંપર્ક</span>
