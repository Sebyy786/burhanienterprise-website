---
import Container from '../ui/Container.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { businessProfile } from '../../data/business';

const weighingLead = businessProfile.divisionContacts.weighing;
---

<section class="relative pt-8 pb-12 sm:pb-16 bg-[#020614] border-b border-border-subtle overflow-hidden font-gujarati">
  <!-- Ambient Gold Glow Accent -->
  <div
    class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.12)_0%,transparent_70%)] blur-3xl -z-10"
    aria-hidden="true"
  ></div>

  <Container size="xl">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-text-muted mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span data-i18n-gu="મુખ્ય પૃષ્ઠ" data-i18n-en="Home">મુખ્ય પૃષ્ઠ</span>
      </a>
      <span class="text-text-subtle">/</span>
      <span class="text-primary font-medium" data-i18n-gu="વજન કાંટા શોરૂમ" data-i18n-en="Weighing Scales Showroom">વજન કાંટા શોરૂમ</span>
    </nav>

    <!-- Main Hero Split Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Content Column -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <Badge variant="gold" size="sm">
            <span data-i18n-gu="ઉમરેઠ શોરૂમ • અધિકૃત વેચાણ &amp; સર્વિસ" data-i18n-en="Umreth Showroom • Authorized Sales &amp; Service">
              ઉમરેઠ શોરૂમ • અધિકૃત વેચાણ &amp; સર્વિસ
            </span>
          </Badge>
          <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/30 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span data-i18n-gu="હાજરમાં સ્ટોક ઉપલબ્ધ" data-i18n-en="Ready Stock Available">હાજરમાં સ્ટોક ઉપલબ્ધ</span>
          </span>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold text-white tracking-tight leading-snug sm:leading-tight">
          <span data-i18n-gu="ડિજિટલ વજન કાંટા " data-i18n-en="Digital Weighing Scales ">ડિજિટલ વજન કાંટા </span>
          <span class="gold-gradient-text font-serif italic" data-i18n-gu="શોરૂમ &amp; કેલિબ્રેશન" data-i18n-en="Showroom &amp; Calibration">શોરૂમ &amp; કેલિબ્રેશન</span>
        </h1>

        <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-body" data-i18n-gu="બુરહાની એન્ટરપ્રાઇઝ ઉમરેઠ: કરિયાણા કાઉન્ટર સ્કેલ, વોટરપ્રૂફ ડેરી કાંટા, હેવી ડ્યુટી પ્લેટફોર્મ સ્કેલ્સ, હેંગિંગ અને જ્વેલરી પ્રિસિઝન સ્કેલ્સનો અધિકૃત શોરૂમ. દરેક કાંટા સાથે સરકારી કેલિબ્રેશન અને લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ સહાય ઉપલબ્ધ છે." data-i18n-en="Burhani Enterprise Umreth: Official physical showroom for grocery counter scales, waterproof dairy scales, heavy-duty platform scales, hanging, and jewellery precision scales. Complete in-shop calibration and government Legal Metrology stamping assistance.">
          બુરહાની એન્ટરપ્રાઇઝ ઉમરેઠ: કરિયાણા કાઉન્ટર સ્કેલ, વોટરપ્રૂફ ડેરી કાંટા, હેવી ડ્યુટી પ્લેટફોર્મ સ્કેલ્સ, હેંગિંગ અને જ્વેલરી પ્રિસિઝન સ્કેલ્સનો અધિકૃત શોરૂમ. દરેક કાંટા સાથે સરકારી કેલિબ્રેશન અને લીગલ મેટ્રોલોજી સ્ટેમ્પિંગ સહાય ઉપલબ્ધ છે.
        </p>

        <!-- Local Trust Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-2">
          <div class="p-2.5 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-2">
            <span class="text-primary text-base">⚖️</span>
            <div>
              <div class="text-[11px] font-bold text-white" data-i18n-gu="અધિકૃત ડીલર" data-i18n-en="Authorized Dealer">અધિકૃત ડીલર</div>
              <div class="text-[9px] text-text-muted font-mono">Rolex, Axpert, Taj, Eagle</div>
            </div>
          </div>
          <div class="p-2.5 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-2">
            <span class="text-emerald-400 text-base">🛡️</span>
            <div>
              <div class="text-[11px] font-bold text-white" data-i18n-gu="સરકારી સ્ટેમ્પિંગ સહાય" data-i18n-en="Stamping Assistance">સરકારી સ્ટેમ્પિંગ સહાય</div>
              <div class="text-[9px] text-text-muted font-mono" data-i18n-gu="લીગલ મેટ્રોલોજી" data-i18n-en="Legal Metrology">લીગલ મેટ્રોલોજી</div>
            </div>
          </div>
          <div class="p-2.5 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-2 col-span-2 sm:col-span-1">
            <span class="text-amber-400 text-base">🔧</span>
            <div>
              <div class="text-[11px] font-bold text-white" data-i18n-gu="સ્થળ પર રિપેરિંગ" data-i18n-en="Local Workshop">સ્થળ પર રિપેરિંગ</div>
              <div class="text-[9px] text-text-muted font-mono" data-i18n-gu="ઉમરેઠ વર્કશોપ" data-i18n-en="Umreth Workshop">ઉમરેઠ વર્કશોપ</div>
            </div>
          </div>
        </div>

        <!-- Division Lead Contact Direct Bar -->
        <div class="pt-3 flex flex-wrap items-center gap-3">
          <Button
            href={weighingLead.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="md"
            ariaLabel="Contact Hozefa on WhatsApp"
            class="shadow-lg shadow-primary/20"
          >
            <svg slot="icon-left" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
            <span data-i18n-gu="હોઝેફાભાઈ સાથે વાત કરો" data-i18n-en="Chat with Hozefa">હોઝેફાભાઈ સાથે વાત કરો</span>
          </Button>

          <a
            href={`tel:${weighingLead.phoneDigits}`}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-surface-soft hover:bg-surface-card border border-border text-xs font-semibold text-white transition-all"
          >
            <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{weighingLead.phone}</span>
          </a>

          <span class="text-[11px] text-text-subtle font-mono">
            📍 લોખંડ બજાર, જૂની પોસ્ટ ઓફિસ સામે, ઉમરેઠ
          </span>
        </div>
      </div>

      <!-- Right Column: Authentic Local Showroom Product Asset -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl bg-gradient-to-b from-[#071330] via-[#040c22] to-[#020614] border-2 border-primary/40 p-4 sm:p-5 shadow-2xl shadow-primary/10 overflow-hidden group">
          <!-- Ambient Card Light -->
          <div class="absolute -top-12 -right-12 w-44 h-44 bg-primary/20 rounded-full blur-2xl pointer-events-none"></div>

          <div class="relative w-full aspect-[4/3] bg-[#01040f] rounded-xl overflow-hidden flex items-center justify-center p-3 border border-border-subtle">
            <img
              src="/images/scale/scale-8.webp"
              alt="બુરહાની એન્ટરપ્રાઇઝ ઉમરેઠ ડિજિટલ વજન કાંટા શોરૂમ - Burhani Enterprise Umreth Weighing Scale Showroom"
              class="max-w-full max-h-full object-contain transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
            <div class="absolute top-2.5 left-2.5">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#020512]/90 text-primary border border-primary/40 backdrop-blur-md">
                ઓરિજિનલ શોરૂમ પ્રોડક્ટ
              </span>
            </div>
            <div class="absolute bottom-2.5 right-2.5">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#020512]/90 text-emerald-400 border border-emerald-500/40 backdrop-blur-md">
                100% Calibrated &amp; Stamped
              </span>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-border-subtle flex items-center justify-between text-xs">
            <div>
              <div class="font-bold text-white font-heading" data-i18n-gu="કોમર્શિયલ કાઉન્ટરટોપ વજન કાંટો" data-i18n-en="Commercial Countertop Scale">
                કોમર્શિયલ કાઉન્ટરટોપ વજન કાંટો
              </div>
              <div class="text-[10px] text-text-gold font-mono">૧ કિલો સ્ટાન્ડર્ડ ટેસ્ટ વજનિયાં સાથે કેલિબ્રેટેડ</div>
            </div>
            <span class="text-[10px] font-mono text-primary font-bold px-2 py-1 rounded bg-primary/10 border border-primary/30">
              ઉમરેઠ શોપ
            </span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
