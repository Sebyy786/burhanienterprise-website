---
import { weighingProducts } from '../../data/weighing';
import { businessProfile } from '../../data/business';

const weighingLead = businessProfile.divisionContacts.weighing;

// Pre-serialize products for modal consumption
const productsJson = JSON.stringify(
  weighingProducts.map((p) => ({
    id: p.id,
    nameGu: p.nameGu,
    nameEn: p.nameEn,
    descGu: p.descGu,
    descEn: p.descEn,
    categoryGu: p.categoryGu,
    categoryEn: p.categoryEn,
    brand: p.brand || 'Burhani Enterprise',
    capacityGu: p.capacityGu || p.capacityEn || '',
    capacityEn: p.capacityEn || '',
    bestUseGu: p.bestUseGu || '',
    bestUseEn: p.bestUseEn || '',
    badgeGu: p.badgeGu,
    badgeEn: p.badgeEn,
    src: p.src,
    alt: p.alt,
    gallery: p.gallery && p.gallery.length > 0 ? p.gallery : [p.src],
    whatsappMsg: p.whatsappMsg,
  }))
);
---

<dialog
  id="showroom-detail-dialog"
  class="fixed inset-0 m-auto z-50 w-[95%] sm:w-[90%] max-w-3xl rounded-2xl bg-[#040b1e] border-2 border-primary/40 shadow-2xl shadow-black/90 p-0 text-white backdrop:bg-[#020510]/85 backdrop:backdrop-blur-md overflow-hidden font-gujarati"
  aria-modal="true"
  aria-labelledby="modal-product-title"
>
  <!-- Embedded Product Data for instant client lookup -->
  <script is:inline type="application/json" id="showroom-modal-data" set:html={productsJson}></script>

  <div class="relative flex flex-col max-h-[90vh]">
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-border-subtle bg-[#020614]">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-primary/20 text-primary border border-primary/40" id="modal-product-brand">
          Brand
        </span>
        <span class="text-xs font-mono text-text-subtle" id="modal-product-category">
          Category
        </span>
      </div>

      <button
        type="button"
        id="showroom-modal-close"
        class="h-8 w-8 rounded-lg flex items-center justify-center text-text-muted hover:text-white hover:bg-surface-soft border border-transparent hover:border-border transition-all cursor-pointer"
        aria-label="Close modal"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Scrollable Body -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Left Column: Gallery (Main Image + Thumbnail Strip) -->
        <div class="md:col-span-5 flex flex-col gap-3">
          <!-- Main Display Image -->
          <div class="relative w-full aspect-square bg-[#01040f] rounded-xl overflow-hidden flex items-center justify-center p-3 border border-border-subtle">
            <img
              id="modal-main-img"
              src="/images/scale/scale-8.webp"
              alt="Product details"
              class="max-w-full max-h-full object-contain transition-all duration-300"
            />
            <div class="absolute top-2.5 right-2.5">
              <span id="modal-capacity-tag" class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-[#020512]/90 text-primary border border-primary/40 backdrop-blur-md">
                Capacity
              </span>
            </div>
          </div>

          <!-- Multi-Image Gallery Thumbnails (Requirement 7) -->
          <div id="modal-gallery-strip" class="flex items-center gap-2 overflow-x-auto pb-1">
            <!-- Dynamically populated if product has multiple images -->
          </div>
        </div>

        <!-- Right Column: Product Specs & Information -->
        <div class="md:col-span-7 flex flex-col gap-3.5">
          <div>
            <h2 id="modal-product-title" class="text-lg sm:text-xl font-heading font-bold text-white mb-1">
              Product Title
            </h2>
            <div id="modal-product-subtitle" class="text-xs text-text-gold font-mono mb-2">
              English Subtitle
            </div>
            <p id="modal-product-desc" class="text-xs text-text-muted leading-relaxed font-body">
              Product description goes here.
            </p>
          </div>

          <!-- Best Use Spec Card -->
          <div class="p-3 rounded-xl bg-[#020512] border border-border-subtle text-xs">
            <div class="text-[10px] font-mono text-primary uppercase font-bold tracking-wider mb-1" data-i18n-gu="વિશેષ ઉપયોગ / Best Application" data-i18n-en="Best Application">
              વિશેષ ઉપયોગ
            </div>
            <div id="modal-product-bestuse" class="text-text leading-snug">
              Application details
            </div>
          </div>

          <!-- Local Shop Guarantees -->
          <div class="grid grid-cols-2 gap-2 text-[11px] font-mono pt-1">
            <div class="p-2 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-1.5 text-emerald-400">
              <span>✓</span>
              <span data-i18n-gu="ઓરિજિનલ સ્પેરપાર્ટ્સ" data-i18n-en="Genuine Spares">ઓરિજિનલ સ્પેરપાર્ટ્સ</span>
            </div>
            <div class="p-2 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-1.5 text-emerald-400">
              <span>✓</span>
              <span data-i18n-gu="સ્ટેમ્પિંગ સહાય ઉપલબ્ધ" data-i18n-en="Stamping Support">સ્ટેમ્પિંગ સહાય ઉપલબ્ધ</span>
            </div>
            <div class="p-2 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-1.5 text-primary">
              <span>⚖️</span>
              <span data-i18n-gu="ઉમરેઠ વર્કશોપ સર્વિસ" data-i18n-en="Umreth Workshop">ઉમરેઠ વર્કશોપ સર્વિસ</span>
            </div>
            <div class="p-2 rounded-lg bg-[#03091e] border border-border-subtle flex items-center gap-1.5 text-primary">
              <span>📍</span>
              <span data-i18n-gu="રૂબરૂ ડેમો ઉપલબ્ધ" data-i18n-en="Shop Demo Ready">રૂબરૂ ડેમો ઉપલબ્ધ</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="px-5 py-4 border-t border-border-subtle bg-[#020614] flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-xs text-text-muted flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
        <span>હોઝેફા બી. રંગવાલા: <strong>+91 99741 64452</strong></span>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <a
          id="modal-whatsapp-cta"
          href={weighingLead.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-primary hover:bg-primary-hover text-[#030712] font-heading font-bold text-xs shadow-lg transition-all active:scale-95"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
          </svg>
          <span data-i18n-gu="WhatsApp પર ભાવ પૂછો" data-i18n-en="Request Quote on WhatsApp">WhatsApp પર ભાવ પૂછો</span>
        </a>

        <a
          href={`tel:${weighingLead.phoneDigits}`}
          class="px-4 py-2.5 rounded-lg bg-surface-soft hover:bg-surface-card border border-border text-xs font-semibold text-white transition-all"
        >
          <span data-i18n-gu="કૉલ કરો" data-i18n-en="Call Directly">કૉલ કરો</span>
        </a>
      </div>
    </div>
  </div>
</dialog>
