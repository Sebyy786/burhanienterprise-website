---
interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'sm', class: className = '' } = Astro.props as Props;

const sizeClasses = {
  sm: 'h-8 w-8 p-1.5',
  md: 'h-9 w-9 p-2',
};
---

<button
  type="button"
  class:list={[
    'theme-toggle-btn inline-flex items-center justify-center rounded-[var(--radius-sm)] border border-border-subtle bg-surface-soft hover:bg-surface-card text-text-gold hover:text-primary transition-all duration-200 cursor-pointer shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
    sizeClasses[size],
    className,
  ]}
  aria-label="Toggle dark or light theme"
  title="થીમ બદલો / Switch Theme"
>
  <!-- Sun Icon (Visible in Dark mode -> click for Light) -->
  <svg
    class="theme-sun-icon w-4 h-4 transition-transform duration-300 transform dark:rotate-0 dark:scale-100 hidden dark:block"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>

  <!-- Moon Icon (Visible in Light mode -> click for Dark) -->
  <svg
    class="theme-moon-icon w-4 h-4 transition-transform duration-300 transform text-slate-700 block dark:hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

