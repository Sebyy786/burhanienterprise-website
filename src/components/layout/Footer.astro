---
import Container from '../ui/Container.astro';
import BrandWordmark from './BrandWordmark.astro';
import { businessProfile } from '../../data/business';
---

<footer
  id="contact"
  class="relative bg-[#02050d] border-t border-border/80 text-text-muted py-14 sm:py-20 select-none overflow-hidden"
  aria-label="Burhani Enterprise Footer"
>
  <!-- Ambient Gold Glint at Top -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-12 sm:gap-16">
    <!-- Top Row: Brand Profile & Navigation Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- Col 1: Brand Info (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        <BrandWordmark size="md" />

        <p
          class="text-xs sm:text-sm text-text-gold font-mono tracking-wide font-gujarati"
          data-i18n-gu="વજન કાંટા • ગેસ એપ્લાયન્સિસ • સોફ્ટવેર સોલ્યુશન્સ"
          data-i18n-en="Weighing Scales • Gas Appliances • Software Solutions"
        >
          વજન કાંટા • ગેસ એપ્લાયન્સિસ • સોફ્ટવેર સોલ્યુશન્સ
        </p>

        <p
          class="text-xs sm:text-sm text-text-muted leading-relaxed max-w-sm font-body font-gujarati"
          data-i18n-gu="બુરહાની એન્ટરપ્રાઇઝ: ડિજિટલ વજન કાંટા, ગેસ ચૂલા, ઓરિજિનલ સ્પેરપાર્ટ્સ, રિપેરિંગ સેવાઓ અને સ્થાનિક વ્યવસાય સોફ્ટવેર સોલ્યુશન્સ. ઉમરેઠ અને આણંદ જિલ્લો."
          data-i18n-en="Burhani Enterprise: Digital weighing scales, gas stoves, genuine spare parts, repair services, and local business software solutions. Serving Umreth and Anand District."
        >
          બુરહાની એન્ટરપ્રાઇઝ: ડિજિટલ વજન કાંટા, ગેસ ચૂલા, ઓરિજિનલ સ્પેરપાર્ટ્સ, રિપેરિંગ સેવાઓ અને સ્થાનિક વ્યવસાય સોફ્ટવેર સોલ્યુશન્સ. ઉમરેઠ અને આણંદ જિલ્લો.
        </p>

        <div class="space-y-2 text-xs text-text-subtle font-mono font-gujarati pt-1">
          <p><span class="text-primary/90 font-semibold">GSTIN:</span> {businessProfile.gstin}</p>
          <div class="flex items-start gap-2">
            <span class="w-2 h-2 rounded-full bg-[#25D366] mt-1 shrink-0"></span>
            <span class="leading-relaxed">
              <span class="text-slate-300 font-semibold" data-i18n-gu="સરનામું:" data-i18n-en="Address:">સરનામું:</span> {businessProfile.contact.address}
            </span>
          </div>
          <div class="flex items-start gap-2 pt-1">
            <span class="text-primary/90 font-semibold">સમય:</span>
            <span class="leading-relaxed">
              સોમ-શનિ: ૯:૦૦ AM – ૮:૩૦ PM | રવિ: ૯:૦૦ AM – ૧:૩૦ PM
            </span>
          </div>
          <div class="flex items-start gap-2 text-text-gold font-semibold">
            <span>સર્વિસ એરિયા:</span>
            <span>ઉમરેઠ અને સમગ્ર આણંદ જિલ્લો</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Quick Links (3 Cols) -->
      <div class="lg:col-span-3 flex flex-col gap-3 font-gujarati">
        <h4
          class="text-xs font-mono uppercase tracking-widest text-primary font-semibold"
          data-i18n-gu="ઝડપી લિંક્સ"
          data-i18n-en="Quick Links"
        >
          ઝડપી લિંક્સ (Quick Links)
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a
              href="#hero"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="મુખ્ય પૃષ્ઠ"
              data-i18n-en="Home"
            >
              મુખ્ય પૃષ્ઠ (Home)
            </a>
          </li>
          <li>
            <a
              href="#scales"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="વજન કાંટા &amp; રિપેરિંગ"
              data-i18n-en="Weighing Scales &amp; Repair"
            >
              વજન કાંટા &amp; રિપેરિંગ
            </a>
          </li>
          <li>
            <a
              href="/weighing-scales"
              class="text-text-muted hover:text-white transition-colors flex items-center gap-1.5"
              data-i18n-gu="ડિજિટલ શોરૂમ"
              data-i18n-en="Digital Showroom"
            >
              <span>ડિજિટલ શોરૂમ</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-primary/20 text-primary border border-primary/40">નવું</span>
            </a>
          </li>
          <li>
            <a
              href="#gas"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="ગેસ સ્ટવ &amp; સાધનો"
              data-i18n-en="Gas Stoves &amp; Spares"
            >
              ગેસ સ્ટવ &amp; સાધનો
            </a>
          </li>
          <li>
            <a
              href="#software"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="સોફ્ટવેર ડેવલપમેન્ટ"
              data-i18n-en="Software Development"
            >
              સોફ્ટવેર ડેવલપમેન્ટ
            </a>
          </li>
          <li>
            <a
              href="#location"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="લોકેશન &amp; ગૂગલ રિવ્યૂ"
              data-i18n-en="Location &amp; Reviews"
            >
              લોકેશન &amp; ગૂગલ રિવ્યૂ
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Direct Division Contacts (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-primary font-semibold">
          Division Contacts
        </h4>
        <div class="space-y-3 text-xs font-gujarati">
          <div class="p-2.5 rounded-lg bg-[#040a1c] border border-border-subtle">
            <span class="text-emerald-400 block text-[10px] font-mono uppercase font-bold">Gas Stoves &amp; Equipment</span>
            <a
              href={businessProfile.divisionContacts.gas.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-200 hover:text-primary transition-colors flex items-center justify-between pt-1"
            >
              <span class="font-bold">{businessProfile.divisionContacts.gas.name}</span>
              <span class="text-text-gold font-mono font-semibold">{businessProfile.divisionContacts.gas.phone}</span>
            </a>
          </div>

          <div class="p-2.5 rounded-lg bg-[#040a1c] border border-border-subtle">
            <span class="text-primary block text-[10px] font-mono uppercase font-bold">Weighing Scales &amp; Repair</span>
            <a
              href={businessProfile.divisionContacts.weighing.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-200 hover:text-primary transition-colors flex items-center justify-between pt-1"
            >
              <span class="font-bold">{businessProfile.divisionContacts.weighing.name}</span>
              <span class="text-text-gold font-mono font-semibold">{businessProfile.divisionContacts.weighing.phone}</span>
            </a>
          </div>

          <div class="p-2.5 rounded-lg bg-[#040a1c] border border-border-subtle">
            <span class="text-indigo-400 block text-[10px] font-mono uppercase font-bold">Software Development</span>
            <a
              href={businessProfile.divisionContacts.software.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-200 hover:text-primary transition-colors flex items-center justify-between pt-1"
            >
              <span class="font-bold">{businessProfile.divisionContacts.software.name}</span>
              <span class="text-text-gold font-mono font-semibold">{businessProfile.divisionContacts.software.phone}</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal Compliance -->
    <div
      class="pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs text-text-subtle"
    >
      <p>
        © {new Date().getFullYear()} Burhani Enterprise. All rights reserved.
      </p>

      <p class="text-[11px] font-mono">
        Lokhand Bazar, Umreth, Anand District, Gujarat.
      </p>
    </div>
  </Container>
</footer>
