---
import Container from '../ui/Container.astro';
import BrandWordmark from './BrandWordmark.astro';
import { businessProfile } from '../../data/business';
---

<footer
  class="relative bg-[#02050d] border-t border-border/80 text-text-muted py-14 sm:py-20 select-none overflow-hidden"
  aria-label="Burhani Enterprise Footer"
>
  <!-- Ambient Gold Glint at Top -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-12 sm:gap-16">
    <!-- Top Row: Brand Profile & Navigation Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- Col 1: Brand Info (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        <BrandWordmark size="md" />

        <p class="text-xs sm:text-sm text-text-muted leading-relaxed max-w-sm mt-2 font-body">
          Burhani Enterprise provides engineered gas manifold systems, heavy-duty commercial truck weighbridges,
          and proprietary weighbridge automation software. Serving Umreth & Anand District, Gujarat.
        </p>

        <!-- Regional Trust Strip -->
        <div class="flex items-center gap-2 text-xs text-text-subtle font-mono mt-2">
          <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
          <span>Operations: Umreth, Anand District, Gujarat</span>
        </div>
      </div>

      <!-- Col 2: Divisions Navigation (3 Cols) -->
      <div class="lg:col-span-3 flex flex-col gap-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-primary font-semibold">
          Engineering Divisions
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href="#gas-solutions" class="text-text-muted hover:text-white transition-colors">
              Gas Solutions & Manifolds
            </a>
          </li>
          <li>
            <a href="#weighing-solutions" class="text-text-muted hover:text-white transition-colors">
              Commercial Truck Weighbridges
            </a>
          </li>
          <li>
            <a href="#software-solutions" class="text-text-muted hover:text-white transition-colors">
              Weighbridge Automation Software
            </a>
          </li>
          <li>
            <a href="#capabilities" class="text-text-muted hover:text-white transition-colors">
              Turnkey Plant Execution
            </a>
          </li>
          <li>
            <a href="#capabilities" class="text-text-muted hover:text-white transition-colors">
              Precision Testing & AMC
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Quick Links & Contact (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-primary font-semibold">
          Contact & Inquiries
        </h4>
        <div class="space-y-2 text-xs sm:text-sm">
          <p class="text-slate-300">
            <span class="text-text-subtle block text-[10px] font-mono uppercase">Works & Service</span>
            {businessProfile.contact.address}
          </p>
          <p class="text-slate-300">
            <span class="text-text-subtle block text-[10px] font-mono uppercase">WhatsApp Rapid Desk</span>
            <a
              href={businessProfile.contact.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-gold hover:text-white hover:underline transition-colors"
            >
              {businessProfile.contact.whatsapp.display}
            </a>
          </p>
          <p class="text-slate-300">
            <span class="text-text-subtle block text-[10px] font-mono uppercase">Email Specification Desk</span>
            <a
              href={`mailto:${businessProfile.contact.email}`}
              class="text-text-gold hover:text-white hover:underline transition-colors"
            >
              {businessProfile.contact.email}
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal Compliance -->
    <div
      class="pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs text-text-subtle"
    >
      <p>
        © {new Date().getFullYear()} Burhani Enterprise. All rights reserved.
      </p>

      <p class="text-[11px] font-mono">
        Serving Umreth & Anand District, Gujarat.
      </p>
    </div>
  </Container>
</footer>
