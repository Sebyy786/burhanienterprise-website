---
import Container from '../ui/Container.astro';
import BrandWordmark from './BrandWordmark.astro';
import { businessProfile } from '../../data/business';
---

<footer
  class="relative bg-[#02050d] border-t border-border/80 text-text-muted py-14 sm:py-20 select-none overflow-hidden"
  aria-label="Burhani Enterprise Footer"
>
  <!-- Ambient Gold Glint at Top -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"
    aria-hidden="true"
  ></div>

  <Container size="xl" class="relative z-10 flex flex-col gap-12 sm:gap-16">
    <!-- Top Row: Brand Profile & Navigation Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- Col 1: Brand Info (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        <BrandWordmark size="md" />

        <p
          class="text-xs sm:text-sm text-text-gold font-mono tracking-wide font-gujarati"
          data-i18n-gu="ગેસ સોલ્યુશન્સ • વજન કાંટા • સોફ્ટવેર સોલ્યુશન્સ"
          data-i18n-en="Gas Solutions • Weighing Scales • Software"
        >
          ગેસ સોલ્યુશન્સ • વજન કાંટા • સોફ્ટવેર સોલ્યુશન્સ
        </p>

        <p
          class="text-xs sm:text-sm text-text-muted leading-relaxed max-w-sm font-body font-gujarati"
          data-i18n-gu="બુરહાની એન્ટરપ્રાઇઝ: કોમર્શિયલ LPG પાઇપલાઇન, દરેક પ્રકારના ગેસ સ્ટવ, તમામ સ્પેરપાર્ટ્સ, રિપેરિંગ, ડિજિટલ વજન કાંટા, વેઇબ્રિજ, સ્ટેમ્પિંગ સહાય અને કસ્ટમ સોફ્ટવેર."
          data-i18n-en="Burhani Enterprise: Commercial LPG pipelines, all gas stoves, spare parts &amp; repairs, digital weighing scales, weighbridges, stamping assistance, and custom software."
        >
          બુરહાની એન્ટરપ્રાઇઝ: કોમર્શિયલ LPG પાઇપલાઇન, દરેક પ્રકારના ગેસ સ્ટવ, તમામ સ્પેરપાર્ટ્સ, રિપેરિંગ, ડિજિટલ વજન કાંટા, વેઇબ્રિજ, સ્ટેમ્પિંગ સહાય અને કસ્ટમ સોફ્ટવેર.
        </p>

        <div class="space-y-1.5 text-xs text-text-subtle font-mono font-gujarati">
          <p><span class="text-primary/90 font-semibold">GSTIN:</span> {businessProfile.gstin}</p>
          <p><span class="text-primary/90 font-semibold">Email:</span> <a href={`mailto:${businessProfile.contact.email}`} class="text-primary hover:underline font-mono">{businessProfile.contact.email}</a></p>
          <div class="flex items-start gap-2 pt-1">
            <span class="w-2 h-2 rounded-full bg-[#25D366] mt-1 shrink-0"></span>
            <span class="leading-relaxed">
              <span data-i18n-gu="સરનામું:" data-i18n-en="Address:">સરનામું:</span> Lokhand Bazar, infront of Old post office, Nr. kansara bazar, Umreth
            </span>
          </div>
        </div>
      </div>

      <!-- Col 2: Quick Links (3 Cols) -->
      <div class="lg:col-span-3 flex flex-col gap-3 font-gujarati">
        <h4
          class="text-xs font-mono uppercase tracking-widest text-primary font-semibold"
          data-i18n-gu="ઝડપી લિંક્સ"
          data-i18n-en="Quick Links"
        >
          ઝડપી લિંક્સ (Quick Links)
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a
              href="#hero"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="મુખ્ય પૃષ્ઠ"
              data-i18n-en="Home"
            >
              મુખ્ય પૃષ્ઠ
            </a>
          </li>
          <li>
            <a
              href="#scales"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="વજન કાંટા"
              data-i18n-en="Weighing Scales"
            >
              વજન કાંટા
            </a>
          </li>
          <li>
            <a
              href="#gas"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="ગેસ સોલ્યુશન્સ"
              data-i18n-en="Gas Solutions"
            >
              ગેસ સોલ્યુશન્સ
            </a>
          </li>
          <li>
            <a
              href="#software"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="સોફ્ટવેર &amp; AI"
              data-i18n-en="Software &amp; AI"
            >
              સોફ્ટવેર &amp; AI
            </a>
          </li>
          <li>
            <a
              href="#capabilities"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="વિશેષતાઓ"
              data-i18n-en="Capabilities"
            >
              વિશેષતાઓ
            </a>
          </li>
          <li>
            <a
              href="#contact"
              class="text-text-muted hover:text-white transition-colors"
              data-i18n-gu="સંપર્ક"
              data-i18n-en="Contact"
            >
              સંપર્ક
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Direct Division Contacts (4 Cols) -->
      <div class="lg:col-span-4 flex flex-col gap-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-primary font-semibold">
          Division Contacts
        </h4>
        <div class="space-y-2.5 text-xs">
          <div>
            <span class="text-text-subtle block text-[10px] font-mono uppercase">Gas Solutions</span>
            <a
              href={businessProfile.divisionContacts.gas.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-primary transition-colors flex items-center justify-between"
            >
              <span>{businessProfile.divisionContacts.gas.name}</span>
              <span class="text-text-gold font-mono">{businessProfile.divisionContacts.gas.phone}</span>
            </a>
          </div>

          <div>
            <span class="text-text-subtle block text-[10px] font-mono uppercase">Weighing Solutions</span>
            <a
              href={businessProfile.divisionContacts.weighing.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-primary transition-colors flex items-center justify-between"
            >
              <span>{businessProfile.divisionContacts.weighing.name}</span>
              <span class="text-text-gold font-mono">{businessProfile.divisionContacts.weighing.phone}</span>
            </a>
          </div>

          <div>
            <span class="text-text-subtle block text-[10px] font-mono uppercase">Software Solutions</span>
            <a
              href={businessProfile.divisionContacts.software.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-primary transition-colors flex items-center justify-between"
            >
              <span>{businessProfile.divisionContacts.software.name}</span>
              <span class="text-text-gold font-mono">{businessProfile.divisionContacts.software.phone}</span>
            </a>
          </div>

          <div class="pt-2 border-t border-border-subtle/60 text-slate-400">
            <span class="text-text-subtle block text-[10px] font-mono uppercase">Works & Service</span>
            <span>{businessProfile.contact.address}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Legal Compliance -->
    <div
      class="pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left text-xs text-text-subtle"
    >
      <p>
        © {new Date().getFullYear()} Burhani Enterprise. All rights reserved.
      </p>

      <p class="text-[11px] font-mono">
        Lokhand Bazar, Umreth, Gujarat.
      </p>
    </div>
  </Container>
</footer>
