---
interface Props {
  href: string;
  label: string;
  labelGujarati?: string;
  labelEnglish?: string;
  active?: boolean;
  class?: string;
  isMobile?: boolean;
}

const {
  href,
  label,
  labelGujarati,
  labelEnglish,
  active = false,
  class: className = '',
  isMobile = false,
} = Astro.props as Props;

const displayLabelGu = labelGujarati || label;
const displayLabelEn = labelEnglish || label;

const desktopStyles =
  'relative inline-flex items-center text-sm font-medium transition-colors duration-200 py-2 font-heading focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#030712] rounded-[var(--radius-sm)]';

const desktopUnderline =
  'after:content-[""] after:absolute after:bottom-0 after:left-0 after:h-[2px] after:bg-primary after:transition-all after:duration-300';

const desktopState = active
  ? 'text-primary after:w-full'
  : 'text-text-muted hover:text-text after:w-0 hover:after:w-full';

const mobileStyles =
  'flex items-center justify-between w-full py-3.5 px-4 text-base font-medium rounded-[var(--radius-md)] transition-all duration-200 font-heading focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary';

const mobileState = active
  ? 'bg-primary/15 text-primary border border-primary/30'
  : 'text-text hover:text-primary hover:bg-surface-soft border border-transparent';
---

{
  isMobile ? (
    <a
      href={href}
      class={`${mobileStyles} ${mobileState} ${className}`}
      aria-current={active ? 'page' : undefined}
    >
      <span
        class="nav-label font-gujarati"
        data-i18n-gu={displayLabelGu}
        data-i18n-en={displayLabelEn}
      >{displayLabelGu}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 text-primary/70"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  ) : (
    <a
      href={href}
      class={`${desktopStyles} ${desktopUnderline} ${desktopState} ${className}`}
      aria-current={active ? 'page' : undefined}
    >
      <span
        class="nav-label font-gujarati"
        data-i18n-gu={displayLabelGu}
        data-i18n-en={displayLabelEn}
      >{displayLabelGu}</span>
    </a>
  )
}
