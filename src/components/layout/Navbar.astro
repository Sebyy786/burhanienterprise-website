---
import { navigationItems } from '../../data/navigation';
import { businessProfile } from '../../data/business';
import BrandWordmark from './BrandWordmark.astro';
import NavLink from './NavLink.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props as Props;
---

<header
  id="navbar-header"
  class="fixed top-0 inset-x-0 z-40 w-full transition-all duration-300 bg-transparent border-b border-transparent header-height"
  data-state="transparent"
>
  <div class="h-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Wordmark -->
    <div class="flex-shrink min-w-0 pr-2">
      <BrandWordmark size="md" />
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Desktop Main Navigation">
      {
        navigationItems.map((item) => {
          const isChildActive = item.children?.some(
            (c) => currentPath === c.href || (c.href !== '/' && currentPath.startsWith(c.href))
          );
          const isActive = currentPath === item.href || isChildActive;

          if (item.children && item.children.length > 0) {
            return (
              <div class="relative group">
                <a
                  href={item.href}
                  class:list={[
                    'relative inline-flex items-center gap-1.5 text-sm font-medium py-2 font-heading focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#030712] rounded-[var(--radius-sm)] transition-colors duration-200',
                    isActive
                      ? 'text-primary'
                      : 'text-text-muted hover:text-text group-hover:text-primary',
                  ]}
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  <span
                    class="nav-label font-gujarati"
                    data-i18n-gu={item.labelGujarati || item.label}
                    data-i18n-en={item.labelEnglish || item.label}
                  >
                    {item.labelGujarati || item.label}
                  </span>
                  <svg
                    class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-primary/70 group-hover:text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>

                <div class="absolute top-full left-0 pt-2 w-72 invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
                  <div class="rounded-xl bg-[#040a1c]/95 backdrop-blur-xl border border-primary/30 p-2 shadow-2xl shadow-black/80 flex flex-col gap-1 font-gujarati">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class="p-2.5 rounded-lg hover:bg-primary/15 hover:border-primary/40 border border-transparent transition-all group/item flex flex-col gap-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
                      >
                        <div class="flex items-center justify-between gap-2">
                          <span
                            class="text-xs font-bold text-white group-hover/item:text-primary transition-colors font-heading"
                            data-i18n-gu={child.labelGujarati}
                            data-i18n-en={child.labelEnglish}
                          >
                            {child.labelGujarati}
                          </span>
                          {child.badge && (
                            <span class="text-[9px] font-mono font-semibold px-1.5 py-0.5 rounded bg-primary/20 text-text-gold border border-primary/40 shrink-0">
                              {child.badge}
                            </span>
                          )}
                        </div>
                        {child.descGu && (
                          <span
                            class="text-[11px] text-text-muted/80 line-clamp-1 font-body"
                            data-i18n-gu={child.descGu}
                            data-i18n-en={child.descEn}
                          >
                            {child.descGu}
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <NavLink
              href={item.href}
              label={item.label}
              labelGujarati={item.labelGujarati}
              labelEnglish={item.labelEnglish}
              active={isActive}
            />
          );
        })
      }
    </nav>

    <!-- Desktop Actions (Language Switcher & WhatsApp CTA) -->
    <div class="hidden lg:flex items-center gap-3 xl:gap-4">
      <!-- Language Switcher -->
      <div
        class="inline-flex items-center rounded-[var(--radius-sm)] bg-surface-soft border border-border-subtle p-0.5 text-xs select-none"
        role="group"
        aria-label="ભાષા પસંદગી / Language Selection"
      >
        <button
          type="button"
          class="lang-btn lang-btn-gu px-2.5 py-1 font-semibold rounded-[var(--radius-sm)] bg-primary text-[#030712] cursor-pointer font-gujarati transition-all text-xs"
          data-lang="gu"
          aria-pressed="true"
          title="ગુજરાતી ભાષા"
        >
          ગુજરાતી
        </button>
        <button
          type="button"
          class="lang-btn lang-btn-en px-2.5 py-1 font-medium rounded-[var(--radius-sm)] text-text-muted hover:text-text cursor-pointer transition-all text-xs"
          data-lang="en"
          aria-pressed="false"
          title="Switch to English"
        >
          EN
        </button>
      </div>

      <!-- WhatsApp CTA Button -->
      <Button
        href={businessProfile.contact.whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="sm"
        ariaLabel="Inquire on WhatsApp"
        class="whitespace-nowrap"
      >
        <svg
          slot="icon-left"
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5 fill-current"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.128-.521-1.615-.67-2.66-2.308-2.74-2.417-.08-.108-.659-.877-.659-1.672 0-.795.414-1.187.561-1.349.146-.162.32-.203.428-.203.107 0 .215.002.308.007.1.005.234-.038.366.279.136.327.464 1.132.505 1.215.041.083.068.18.012.289-.056.108-.083.177-.165.273-.082.096-.174.215-.248.289-.083.083-.17.172-.073.338.097.166.432.713.927 1.154.636.568 1.172.744 1.338.827.166.083.264.069.362-.042.098-.111.42-.489.532-.656.113-.167.225-.139.378-.083.153.056.974.459 1.141.542.167.083.278.125.32.194.041.07.041.405-.103.81zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.662 1.442 5.179L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        WhatsApp
      </Button>
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        id="navbar-hamburger"
        class="inline-flex items-center justify-center h-10 w-10 rounded-[var(--radius-md)] text-text hover:text-primary hover:bg-surface-soft border border-border-subtle transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <!-- Animated 3-line hamburger icon -->
        <span class="sr-only">Toggle Navigation</span>
        <svg
          class="h-6 w-6 stroke-current"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6" class="hamburger-line top origin-center transition-all"></line>
          <line x1="4" y1="12" x2="20" y2="12" class="hamburger-line middle transition-all"></line>
          <line x1="4" y1="18" x2="20" y2="18" class="hamburger-line bottom origin-center transition-all"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mount Accessible Mobile Menu Drawer -->
<MobileMenu currentPath={currentPath} />

<script>
  function initNavigation() {
    const header = document.getElementById('navbar-header');
    const hamburgerBtn = document.getElementById('navbar-hamburger');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const panel = document.getElementById('mobile-menu-panel');
    const closeBtn = document.getElementById('mobile-menu-close');
    const navItems = document.querySelectorAll('.mobile-nav-item');

    if (!header || !hamburgerBtn || !mobileMenu || !backdrop || !panel || !closeBtn) return;

    let isMenuOpen = false;

    // 1. Navbar Visual State Management (transparent | scrolled glass | mobile-open solid)
    function updateHeaderVisualState() {
      if (!header) return;
      if (isMenuOpen) {
        header.dataset.state = 'mobile-open';
        header.className =
          'fixed top-0 inset-x-0 z-40 w-full transition-all duration-300 bg-[#030712] border-b border-border shadow-2xl header-height';
      } else if (window.scrollY > 20) {
        header.dataset.state = 'scrolled';
        header.className =
          'fixed top-0 inset-x-0 z-40 w-full transition-all duration-300 bg-[#030712]/80 backdrop-blur-lg border-b border-primary/25 shadow-[0_8px_32px_rgba(0,0,0,0.65)] header-height';
      } else {
        header.dataset.state = 'transparent';
        header.className =
          'fixed top-0 inset-x-0 z-40 w-full transition-all duration-300 bg-transparent border-b border-transparent header-height';
      }
    }

    window.addEventListener('scroll', updateHeaderVisualState, { passive: true });
    updateHeaderVisualState();

    // 2. Open Mobile Menu
    function openMenu() {
      if (!hamburgerBtn || !mobileMenu || !backdrop || !panel || !closeBtn) return;
      if (isMenuOpen) return;
      isMenuOpen = true;
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      hamburgerBtn.setAttribute('aria-label', 'Close navigation menu');

      // Show drawer
      mobileMenu.classList.remove('invisible', 'pointer-events-none');
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');

      // Body scroll lock
      document.body.style.overflow = 'hidden';

      // Update header state
      updateHeaderVisualState();

      // Focus close button initially
      closeBtn.focus();
    }

    // 3. Close Mobile Menu
    function closeMenu() {
      if (!hamburgerBtn || !mobileMenu || !backdrop || !panel) return;
      if (!isMenuOpen) return;
      isMenuOpen = false;
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerBtn.setAttribute('aria-label', 'Open navigation menu');

      // Hide drawer
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');

      // Restore body scroll
      document.body.style.overflow = '';

      // Update header state
      updateHeaderVisualState();

      // Delay hiding visibility for animation
      setTimeout(() => {
        if (!isMenuOpen && mobileMenu) {
          mobileMenu.classList.add('invisible', 'pointer-events-none');
        }
      }, 300);

      // Restore focus to hamburger button
      hamburgerBtn.focus();
    }

    // Toggle trigger
    hamburgerBtn.addEventListener('click', () => {
      if (isMenuOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    // Close when clicking any nav item
    navItems.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // 4. Keyboard Navigation: ESC key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen) {
        closeMenu();
      }
    });

    // 5. Accessible Focus Trap inside Mobile Drawer
    mobileMenu.addEventListener('keydown', (e) => {
      if (!isMenuOpen || e.key !== 'Tab' || !panel) return;

      const focusables = panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;

      const firstElement = focusables[0];
      const lastElement = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        }
      } else {
        if (document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    });
  }

  // Support both initial load and Astro page transitions
  document.addEventListener('DOMContentLoaded', initNavigation);
  document.addEventListener('astro:page-load', initNavigation);
</script>
